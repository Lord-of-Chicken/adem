{% extends 'layout/street.html.twig' %}

{% block title %}{{ 'faq.title'|trans }} | {{ site_brand.title }}{% endblock %}

{% block meta_description %}{{ 'faq.meta_description'|trans }}{% endblock %}

{% block head %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "{{ 'faq.q1.question'|trans }}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{{ 'faq.q1.answer'|trans }}"
                }
            },
            {
                "@type": "Question",
                "name": "{{ 'faq.q2.question'|trans }}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{{ 'faq.q2.answer'|trans }}"
                }
            },
            {
                "@type": "Question",
                "name": "{{ 'faq.q3.question'|trans }}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{{ 'faq.q3.answer'|trans }}"
                }
            },
            {
                "@type": "Question",
                "name": "{{ 'faq.q4.question'|trans }}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{{ 'faq.q4.answer'|trans }}"
                }
            },
            {
                "@type": "Question",
                "name": "{{ 'faq.q5.question'|trans }}",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "{{ 'faq.q5.answer'|trans }}"
                }
            }
        ]
    }
    </script>
{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    <section class="section">
        <div class="section__inner section__inner--narrow">
            <h1 class="section__title section__title--tag">{{ page.title }}</h1>
            <p class="section__intro">{{ page.intro }}</p>

            <div class="faq-list">
                <div class="faq-item card">
                    <h2 class="faq-item__question">{{ 'faq.q1.question'|trans }}</h2>
                    <p class="faq-item__answer">{{ 'faq.q1.answer'|trans }}</p>
                </div>

                <div class="faq-item card">
                    <h2 class="faq-item__question">{{ 'faq.q2.question'|trans }}</h2>
                    <p class="faq-item__answer">{{ 'faq.q2.answer'|trans }}</p>
                </div>

                <div class="faq-item card">
                    <h2 class="faq-item__question">{{ 'faq.q3.question'|trans }}</h2>
                    <p class="faq-item__answer">{{ 'faq.q3.answer'|trans }}</p>
                </div>

                <div class="faq-item card">
                    <h2 class="faq-item__question">{{ 'faq.q4.question'|trans }}</h2>
                    <p class="faq-item__answer">{{ 'faq.q4.answer'|trans }}</p>
                </div>

                <div class="faq-item card">
                    <h2 class="faq-item__question">{{ 'faq.q5.question'|trans }}</h2>
                    <p class="faq-item__answer">{{ 'faq.q5.answer'|trans }}</p>
                </div>
            </div>
        </div>
    </section>
</div>
{% endblock %}
