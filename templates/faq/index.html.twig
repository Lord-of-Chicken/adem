{% extends 'layout/street.html.twig' %}

{% block title %}{{ 'faq.title'|trans }} | {{ site_brand.title }}{% endblock %}

{% block meta_description %}{{ 'faq.meta_description'|trans }}{% endblock %}
{% block og_title %}{{ 'faq.title'|trans }} | {{ site_brand.title }}{% endblock %}
{% block og_description %}{{ 'faq.meta_description'|trans }}{% endblock %}
{% block og_image %}{{ absolute_url(asset('img/Social/og-home-preview.jpg')) }}{% endblock %}

{% block head %}
    {{ parent() }}
    {%- set _faq_qa = [] %}
    {%- for i in 1..6 %}
        {%- set _faq_qa = _faq_qa|merge([{
            '@type': 'Question',
            'name': ('faq.q' ~ i ~ '.question')|trans,
            'acceptedAnswer': { '@type': 'Answer', 'text': ('faq.q' ~ i ~ '.answer')|trans }
        }]) %}
    {%- endfor %}
    <script type="application/ld+json">
    {{ {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        'mainEntity': _faq_qa
    }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}
    </script>
    {% include '_partials/breadcrumb_jsonld.html.twig' with { items: [
        { name: 'nav.home'|trans, url: url('app_home') },
        { name: page.title, url: url('app_faq') }
    ] } %}
{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    <section class="section section--auth">
        <div class="section__inner section__inner--narrow">
            <h1 class="section__title section__title--tag">{{ page.title }}</h1>

            <div class="card">
                <h2 class="card__title">{{ 'faq.q1.question'|trans }}</h2>
                <p class="section__intro">{{ 'faq.q1.answer'|trans }}</p>

                <h2 class="card__title">{{ 'faq.q2.question'|trans }}</h2>
                <p class="section__intro">{{ 'faq.q2.answer'|trans }}</p>

                <h2 class="card__title">{{ 'faq.q3.question'|trans }}</h2>
                <p class="section__intro">{{ 'faq.q3.answer'|trans }}</p>

                <h2 class="card__title">{{ 'faq.q4.question'|trans }}</h2>
                <p class="section__intro">{{ 'faq.q4.answer'|trans }}</p>

                <h2 class="card__title">{{ 'faq.q5.question'|trans }}</h2>
                <p class="section__intro">{{ 'faq.q5.answer'|trans }}</p>

                <h2 class="card__title">{{ 'faq.q6.question'|trans }}</h2>
                <p class="section__intro">{{ 'faq.q6.answer'|trans }}</p>
            </div>
        </div>
    </section>
</div>
{% endblock %}
