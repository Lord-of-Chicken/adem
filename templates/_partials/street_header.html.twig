{% set brand = brand|default(site_brand) %}
{% set nav_links = nav_links|default([{ label: 'Offres', href: path('app_home') ~ '#offres' }, { label: 'Médias', href: path('app_home') ~ '#medias' }]) %}
{% set cta_newsletter = cta_newsletter|default({ href: path('app_home') ~ '#newsletter', label: '> Recevoir des notifications et invitations (mailing list)' }) %}

<header class="site-header">
    <div class="site-header__inner">
        <a href="{{ path('app_home') }}" class="site-brand">
            {% if brand.logo_asset is defined and brand.logo_asset %}
                <img class="site-brand__logo" src="{{ asset(brand.logo_asset) }}" alt="" width="128" height="128" loading="lazy" decoding="async">
            {% endif %}
        </a>

        <button class="site-header__menu-toggle" id="menuToggle" aria-expanded="false" aria-label="Menu">
            <span class="site-header__menu-toggle__line"></span>
            <span class="site-header__menu-toggle__line"></span>
            <span class="site-header__menu-toggle__line"></span>
        </button>

        <nav class="site-nav" aria-label="Navigation principale">
            {% for link in nav_links %}
                <a href="{{ link.href }}" class="site-nav__link">{{ link.label }}</a>
            {% endfor %}
            <a href="{{ path('app_about') }}" class="site-nav__link">Qui est Adem?</a>
            <a href="{{ path('app_contact') }}" class="site-nav__link">Contact</a>

            <div class="site-header__account site-header__account--mobile">
                <a href="{{ path('app_cart_index') }}" class="site-nav__link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    Panier
                    {% if cart_line_count is defined and cart_line_count > 0 %}
                        <span class="site-header__cart-badge">{{ cart_line_count }}</span>
                    {% endif %}
                </a>

                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('app_profile') }}" class="site-nav__link">Profil</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="site-nav__link">Connexion</a>
                    <a href="{{ path('app_register') }}" class="site-nav__link">Inscription</a>
                {% endif %}
            </div>
        </nav>

        <div class="site-header__account site-header__account--desktop">
            <a href="{{ path('app_cart_index') }}" class="site-header__cart">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                Panier
                {# On affiche le badge seulement s'il y a des articles #}
                {% if cart_line_count is defined and cart_line_count > 0 %}
                    <span class="site-header__cart-badge">{{ cart_line_count }}</span>
                {% endif %}
            </a>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin') }}" class="site-nav__link" data-turbo="false">Admin</a>
            {% endif %}

            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_profile') }}" class="site-nav__link">Profil</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="site-nav__link">Connexion</a>
                <a href="{{ path('app_register') }}" class="site-nav__link">Inscription</a>
            {% endif %}
        </div> {# Fermeture de site-header__account #}
    </div> {# Fermeture de site-header__inner #}
</header>