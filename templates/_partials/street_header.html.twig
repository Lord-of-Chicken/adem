{% set brand = brand|default(site_brand) %}
{% set nav_links = nav_links|default([{ label: 'Médias', href: path('app_home') ~ '#medias' }]) %}
{% set cta_newsletter = cta_newsletter|default({ href: path('app_home') ~ '#newsletter', label: '> Recevoir des notifications et invitations (mailing list)' }) %}

<header class="site-header">
    <div class="site-header__inner">
        <a href="{{ path('app_home') }}" class="site-brand">
            {% if brand.logo_asset is defined and brand.logo_asset %}
                <img class="site-brand__logo" src="{{ asset(brand.logo_asset) }}" alt="" width="128" height="128" loading="lazy" decoding="async">
            {% endif %}
            <span class="site-brand__text">
                <span class="site-brand__tagline">{{ brand.tagline }}</span>
            </span>
        </a>

        <nav class="site-nav" aria-label="Navigation principale">
            {% for link in nav_links %}
                <a href="{{ link.href }}" class="site-nav__link">{{ link.label }}</a>
            {% endfor %}
            <a href="{{ path('app_contact') }}" class="site-nav__link">Contact</a>
        </nav>

        <div class="site-header__account">
            <a href="{{ path('app_cart_index') }}" class="site-header__cart">
                Panier
                {# On affiche le badge seulement s'il y a des articles #}
                {% if cart_line_count is defined and cart_line_count > 0 %}
                    <span class="site-header__cart-badge">{{ cart_line_count }}</span>
                {% endif %}
            </a>

            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_profile') }}" class="site-nav__link site-nav__link--compact">Profil</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="site-nav__link site-nav__link--compact site-nav__link--red">Connexion</a>
                <a href="{{ path('app_register') }}" class="site-nav__link site-nav__link--compact site-nav__link--red">Inscription</a>
            {% endif %}
        </div> {# Fermeture de site-header__account #}
    </div> {# Fermeture de site-header__inner #}
</header>