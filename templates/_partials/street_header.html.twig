{% set brand = brand|default(site_brand) %}
{% set nav_links = nav_links|default([{ label: 'Offres', href: path('app_home') ~ '#offres' }, { label: 'Médias', href: path('app_home') ~ '#medias' }]) %}
{% set cta_newsletter = cta_newsletter|default({ href: path('app_home') ~ '#newsletter', label: '> Recevoir des notifications et invitations (mailing list)' }) %}

{{ component('SiteHeader', {
    logoAsset: brand.logo_asset,
    title: brand.title,
    navLinks: nav_links,
    cartLineCount: cart_line_count,
    isAuthenticated: is_granted('ROLE_USER'),
    isAdmin: is_granted('ROLE_ADMIN'),
    profileUrl: path('app_profile'),
    loginUrl: path('app_login'),
    registerUrl: path('app_register'),
    cartUrl: path('app_cart_index'),
    adminUrl: path('admin')
}) }}