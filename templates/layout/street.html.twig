{% extends 'base.html.twig' %}

{% block body_class %}page-street{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {% include '_partials/street_header.html.twig' %}

    {% block street_main %}{% endblock %}

    <footer class="site-footer">
        <div class="site-footer__inner">
            <p>{{ footer_line|default('La Ruelle d\'Adem') }}</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const menuToggle = document.getElementById('menuToggle');
            const siteNav = document.querySelector('.site-nav');

            if (menuToggle && siteNav) {
                menuToggle.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
                    menuToggle.setAttribute('aria-expanded', !isExpanded);
                    siteNav.classList.toggle('site-nav--open', !isExpanded);
                });

                document.addEventListener('click', function(e) {
                    if (!menuToggle.contains(e.target) && !siteNav.contains(e.target)) {
                        menuToggle.setAttribute('aria-expanded', 'false');
                        siteNav.classList.remove('site-nav--open');
                    }
                });

                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        menuToggle.setAttribute('aria-expanded', 'false');
                        siteNav.classList.remove('site-nav--open');
                    }
                });
            }

            // Force header to stay fixed
            const siteHeader = document.querySelector('.site-header');
            const constructionBanner = document.querySelector('.construction-banner');
            if (siteHeader && constructionBanner) {
                function updatePositions() {
                    const bannerHeight = constructionBanner.offsetHeight;
                    siteHeader.style.top = bannerHeight + 'px';
                }
                window.addEventListener('resize', updatePositions);
                // Initial set
                updatePositions();
            }
        });
    </script>
{% endblock %}