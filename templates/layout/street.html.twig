{% extends 'base.html.twig' %}

{% block body_class %}page-street{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/styles/ruelle.css') }}">
{% endblock %}

{% block body %}
    <div class="street-bg"></div>
    
    {% include '_partials/street_header.html.twig' %}

    {% block street_main %}{% endblock %}

    <footer class="site-footer">
        <div class="site-footer__inner">
            <p>{{ footer_line|default('La Ruelle d\'Adem') }}</p>
        </div>
    </footer>
{% endblock %}