{% extends 'base.html.twig' %}

{% block body_class %}page-street{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="street-main-content">
        {# Flash messages displayed once for all pages #}
        {% for message in app.flashes('success') %}
            <div class="flash flash--success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash flash--danger">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('warning') %}
            <div class="flash flash--warning">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('info') %}
            <div class="flash flash--info">{{ message }}</div>
        {% endfor %}

        {% block street_main %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <p>{{ footer_line|default(site_brand.title) }}</p>
        </div>
    </footer>
{% endblock %}