{% extends 'base.html.twig' %}

{% block body_class %}page-street{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    <main class="street-main-content">
        <div class="flash-container">
            {# Flash messages displayed once for all pages #}
            {% for message in app.flashes('success') %}
                <div class="flash flash--success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="flash flash--danger">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('warning') %}
                <div class="flash flash--warning">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('info') %}
                <div class="flash flash--info">{{ message }}</div>
            {% endfor %}
        </div>

        {% block street_main %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <div class="site-footer__brand">
                <span class="site-footer__title">{{ site_brand.title }}</span>
                <span class="site-footer__tagline">{{ site_brand.tagline }}</span>
            </div>
            <nav class="site-footer__nav" aria-label="Navigation pied de page">
                <a href="{{ path('app_about') }}" class="site-footer__link">{{ 'nav.about'|trans }}</a>
                <a href="{{ path('app_faq') }}" class="site-footer__link">{{ 'nav.faq'|trans }}</a>
                <a href="{{ path('app_contact') }}" class="site-footer__link">{{ 'nav.contact'|trans }}</a>
            </nav>
            <p class="site-footer__copy">&copy; {{ "now"|date("Y") }} {{ site_brand.title }}</p>
        </div>
    </footer>
{% endblock %}