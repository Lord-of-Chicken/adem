{% extends 'base.html.twig' %}

{% block body_class %}page-street{% endblock %}

{% block stylesheets %}
<style>
/* Style chantier pour le bandeau */
.section--construction {
    background: linear-gradient(135deg, #ff6b35 0%, #f7931e 50%, #fdc830 100%);
    border: 4px solid #000;
    border-radius: 0;
    position: relative;
    overflow: hidden;
    box-shadow: 0 8px 0 #000, 0 16px 20px rgba(0,0,0,0.3);
    transform: rotate(-1deg);
    margin: 20px;
}

.section--construction::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
        45deg,
        transparent,
        transparent 10px,
        rgba(255,255,255,0.1) 10px,
        rgba(255,255,255,0.1) 20px
    );
    pointer-events: none;
}

.section--construction::after {
    content: '!!!';
    position: absolute;
    top: 10px;
    right: 20px;
    font-size: 24px;
    font-weight: bold;
    color: #000;
    animation: blink 1s infinite;
}

.section--construction .section__inner {
    padding: 20px;
    text-align: center;
    position: relative;
    z-index: 1;
}

.section--construction .section__title--tag {
    background: #000;
    color: #fff;
    padding: 8px 20px;
    display: inline-block;
    font-weight: bold;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 2px;
    border: 2px solid #fff;
    margin-bottom: 10px;
    transform: rotate(2deg);
    box-shadow: 4px 4px 0 #000;
}

.section--construction .section__intro {
    color: #000;
    font-weight: bold;
    font-size: 16px;
    text-shadow: 2px 2px 0 #fff;
    margin: 0;
}

@keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
}

@media (max-width: 768px) {
    .section--construction {
        margin: 10px;
        transform: rotate(-0.5deg);
    }
    
    .section--construction .section__title--tag {
        font-size: 16px;
        padding: 6px 15px;
    }
    
    .section--construction .section__intro {
        font-size: 14px;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="street-bg" aria-hidden="true"></div>
<div class="street-splats" aria-hidden="true">
    <span class="street-splats__blob street-splats__blob--1"></span>
    <span class="street-splats__blob street-splats__blob--2"></span>
    <span class="street-splats__blob street-splats__blob--3"></span>
</div>

<section class="section section--reveal" id="construction" style="--reveal: 1" aria-labelledby="construction-title">
    <div class="section__inner section__inner--narrow">
        <h2 id="construction-title" class="section__title section__title--tag">CHANTIER EN COURS</h2>
        <p class="section__intro">Le site est actuellement en construction. Revenez bientôt pour découvrir la version finale !</p>
    </div>
</section>

{% include '_partials/street_header.html.twig' %}

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="flash flash--{{ label }}" role="status">{{ message }}</div>
    {% endfor %}
{% endfor %}

{% block street_main %}{% endblock %}

<footer class="site-footer">
    <p class="site-footer__text">{{ footer_line|default('La Ruelle d’Adem — Flower Power') }}</p>
</footer>
{% endblock %}
