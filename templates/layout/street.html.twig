{% extends 'base.html.twig' %}

{% block body_class %}page-street{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
    {% include '_partials/street_header.html.twig' %}

    <main class="street-main-content">
        {# Flash messages displayed once for all pages #}
        {% for message in app.flashes('success') %}
            <div class="flash flash--success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="flash flash--danger">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('warning') %}
            <div class="flash flash--warning">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('info') %}
            <div class="flash flash--info">{{ message }}</div>
        {% endfor %}

        {% block street_main %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <p>{{ footer_line|default('La Ruelle d\'Adem') }}</p>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const menuToggle = document.getElementById('menuToggle');
            const siteNav = document.querySelector('.site-nav');

            if (menuToggle && siteNav) {
                menuToggle.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
                    menuToggle.setAttribute('aria-expanded', !isExpanded);
                    siteNav.classList.toggle('site-nav--open', !isExpanded);
                });

                document.addEventListener('click', function(e) {
                    if (!menuToggle.contains(e.target) && !siteNav.contains(e.target)) {
                        menuToggle.setAttribute('aria-expanded', 'false');
                        siteNav.classList.remove('site-nav--open');
                    }
                });

                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                        menuToggle.setAttribute('aria-expanded', 'false');
                        siteNav.classList.remove('site-nav--open');
                    }
                });
            }

        });
    </script>
{% endblock %}