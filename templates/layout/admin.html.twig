{% extends 'base.html.twig' %}

{% block title %}Admin | {{ site_brand.title }}{% endblock %}

{% block body_class %}page-admin{% endblock %}

{% block top_bars %}
    {% include '_partials/top_bars.html.twig' %}
{% endblock %}

{% block stylesheets %}{% endblock %}

{% block body %}
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-sidebar__header">
                <h2 class="admin-sidebar__title">Admin</h2>
            </div>
            <nav class="admin-nav">
                <a href="{{ path('app_admin') }}" class="admin-nav__link {{ app.request.attributes.get('_route') == 'app_admin' ? 'admin-nav__link--active' : '' }}">
                    Dashboard
                </a>
                <a href="{{ path('app_admin_carousel') }}" class="admin-nav__link {{ app.request.attributes.get('_route') == 'app_admin_carousel' ? 'admin-nav__link--active' : '' }}">
                    Carousel
                </a>
                <a href="{{ path('app_admin_purchases') }}" class="admin-nav__link {{ app.request.attributes.get('_route') == 'app_admin_purchases' ? 'admin-nav__link--active' : '' }}">
                    Achats
                </a>
                <a href="{{ path('app_admin_users') }}" class="admin-nav__link {{ app.request.attributes.get('_route') == 'app_admin_users' ? 'admin-nav__link--active' : '' }}">
                    Utilisateurs
                </a>
                <a href="{{ path('admin_translations', { locale: 'fr' }) }}" class="admin-nav__link {{ app.request.attributes.get('_route') == 'admin_translations' ? 'admin-nav__link--active' : '' }}">
                    Traductions
                </a>
            </nav>
        </aside>
        <main class="admin-main">
            {% block admin_content %}
                {% block admin_main %}{% endblock %}
            {% endblock %}
        </main>
    </div>
{% endblock %}
