{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block content_header %}
    {{ parent() }}
{% endblock %}

{% block main %}
    <script type="module">
        import Sortable from 'sortablejs';

        console.log('Script module loaded, Sortable:', Sortable);

        document.addEventListener('DOMContentLoaded', function() {
            const tableBody = document.querySelector('tbody');
            if (!tableBody) {
                console.log('Table body not found');
                return;
            }

            console.log('Initializing sortable for EasyAdmin media items');
            console.log('Table body:', tableBody);

            // Add drag handle column to the table header
            const tableHead = document.querySelector('thead tr');
            if (tableHead) {
                const handleHeader = document.createElement('th');
                handleHeader.textContent = '';
                handleHeader.style.width = '40px';
                tableHead.insertBefore(handleHeader, tableHead.firstChild);
            }

            // Add drag handles to each row
            const rows = tableBody.querySelectorAll('tr');
            console.log('Found rows:', rows.length);
            
            rows.forEach((row, index) => {
                const handleCell = document.createElement('td');
                handleCell.className = 'drag-handle';
                handleCell.style.cursor = 'move';
                handleCell.style.padding = '8px';
                handleCell.style.textAlign = 'center';
                handleCell.style.backgroundColor = '#f0f0f0';
                handleCell.style.fontWeight = 'bold';
                handleCell.textContent = '☰';
                console.log(`Adding handle to row ${index}`);
                row.insertBefore(handleCell, row.firstChild);
                
                // Try to find the ID - check different columns
                let id = null;
                const cells = row.querySelectorAll('td');
                cells.forEach((cell, cellIndex) => {
                    const text = cell.textContent.trim();
                    // Check if it's a number (likely ID)
                    if (/^\d+$/.test(text) && !id) {
                        id = text;
                        console.log(`Row ${index}: Found ID ${id} in column ${cellIndex}`);
                    }
                });
                
                if (id) {
                    row.dataset.id = id;
                } else {
                    console.log(`Row ${index}: Could not find ID`);
                }
            });

            console.log('SortableJS loaded, initializing');
            console.log('Table body after adding handles:', tableBody);
            
            new Sortable(tableBody, {
                animation: 150,
                handle: '.drag-handle',
                ghostClass: 'sortable-ghost',
                dragClass: 'sortable-drag',
                onEnd: (evt) => {
                    console.log('Drag ended, updating order');
                    updateOrder();
                }
            });

            console.log('Sortable initialized');

            function updateOrder() {
                const rows = tableBody.querySelectorAll('tbody tr');
                const orders = [];

                rows.forEach((row, index) => {
                    const id = row.dataset.id;
                    if (id) {
                        orders.push({ id: parseInt(id), sortOrder: index + 1 });
                    }
                });

                console.log('Sending orders:', orders);

                if (orders.length === 0) {
                    console.log('No orders to send');
                    return;
                }

                fetch('/admin/media-item/reorder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ orders: orders }),
                })
                .then(response => response.json())
                .then(data => {
                    console.log('Response:', data);
                    if (data.success) {
                        // Reload the page to show updated order
                        window.location.reload();
                    } else {
                        console.error('Server returned error:', data);
                    }
                })
                .catch(error => console.error('Error updating order:', error));
            }
        });
    </script>

    <style>
        .sortable-ghost {
            opacity: 0.4;
            background-color: #f0f0f0;
        }
        .sortable-drag {
            background-color: #e0e0e0;
        }
    </style>

    {{ parent() }}
{% endblock %}
