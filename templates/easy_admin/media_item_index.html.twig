{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block content_header %}
    {{ parent() }}
{% endblock %}

{% block main %}
    {{ parent() }}

    <!-- Modal Image Editor -->
    <div id="imageEditorModal" class="modal" style="display: none;">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Éditeur d'image</h5>
                    <button type="button" class="close" onclick="closeImageEditor()">&times;</button>
                </div>
                <div class="modal-body" data-controller="image-editor" data-image-editor-upload-url="{{ path('admin_media_item_upload_image', {entityId: '__ENTITY_ID__'}) }}">
                    <div class="image-editor-container">
                        <div class="image-editor-main">
                            <div class="image-editor-canvas">
                                <img id="image-to-edit" src="/__ASSET_PATH__" alt="" data-image-editor-target="image" crossorigin="anonymous">
                            </div>

                            <div class="image-editor-controls">
                                <div class="control-group">
                                    <h3>Rotation</h3>
                                    <button type="button" class="admin-btn admin-btn--secondary" data-action="click->image-editor#rotateLeft">
                                        Rotation gauche
                                    </button>
                                    <button type="button" class="admin-btn admin-btn--secondary" data-action="click->image-editor#rotateRight">
                                        Rotation droite
                                    </button>
                                    <button type="button" class="admin-btn admin-btn--secondary" data-action="click->image-editor#flipHorizontal">
                                        Miroir horizontal
                                    </button>
                                    <button type="button" class="admin-btn admin-btn--secondary" data-action="click->image-editor#flipVertical">
                                        Miroir vertical
                                    </button>
                                </div>

                                <div class="control-group">
                                    <h3>Ajustements</h3>
                                    <div class="control-item">
                                        <label for="contrast-slider">Contraste: <span id="contrast-value">100%</span></label>
                                        <input type="range" id="contrast-slider" min="0" max="200" value="100" data-action="input->image_editor#setContrast">
                                    </div>
                                    <div class="control-item">
                                        <label for="brightness-slider">Luminosité: <span id="brightness-value">100%</span></label>
                                        <input type="range" id="brightness-slider" min="0" max="200" value="100" data-action="input->image_editor#setBrightness">
                                    </div>
                                </div>

                                <div class="control-group">
                                    <h3>Actions</h3>
                                    <button type="button" class="admin-btn admin-btn--primary" data-action="click->image_editor#crop">
                                        Recadrer et sauvegarder
                                    </button>
                                    <button type="button" class="admin-btn admin-btn--secondary" onclick="closeImageEditor()">
                                        Annuler
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <link rel="stylesheet" href="{{ asset('styles/cropper.css') }}">

    <style>
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 9999;
        }

        .modal-dialog {
            max-width: 1200px;
            margin: 50px auto;
        }

        .modal-content {
            background: white;
            border-radius: 8px;
            overflow: hidden;
        }

        .modal-header {
            padding: 15px 20px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-body {
            padding: 20px;
        }

        .close {
            background: none;
            border: none;
            font-size: 24px;
            cursor: pointer;
        }

        .image-editor-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .image-editor-main {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 20px;
        }

        .image-editor-canvas {
            background: #f8fafc;
            border: 2px dashed #cbd5e1;
            border-radius: 8px;
            min-height: 500px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .image-editor-canvas img {
            max-width: 100%;
            max-height: 500px;
        }

        .image-editor-controls {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .control-group {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 15px;
        }

        .control-group h3 {
            margin: 0 0 15px 0;
            font-size: 14px;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .control-group .admin-btn {
            margin-bottom: 8px;
            width: 100%;
        }

        .control-item {
            margin-bottom: 15px;
        }

        .control-item label {
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
            color: #64748b;
        }

        .control-item input[type="range"] {
            width: 100%;
        }
    </style>

    <script>
        function openImageEditor(entityId, assetPath) {
            const modal = document.getElementById('imageEditorModal');
            const image = document.getElementById('image-to-edit');
            const controller = modal.querySelector('[data-controller="image-editor"]');
            
            image.src = '/' + assetPath;
            controller.setAttribute('data-image-editor-upload-url', controller.getAttribute('data-image-editor-upload-url').replace('__ENTITY_ID__', entityId));
            
            modal.style.display = 'block';
        }

        function closeImageEditor() {
            document.getElementById('imageEditorModal').style.display = 'none';
        }

        document.addEventListener('DOMContentLoaded', function() {
            const contrastSlider = document.getElementById('contrast-slider');
            const brightnessSlider = document.getElementById('brightness-slider');
            const contrastValue = document.getElementById('contrast-value');
            const brightnessValue = document.getElementById('brightness-value');

            if (contrastSlider && contrastValue) {
                contrastSlider.addEventListener('input', function() {
                    contrastValue.textContent = this.value + '%';
                });
            }

            if (brightnessSlider && brightnessValue) {
                brightnessSlider.addEventListener('input', function() {
                    brightnessValue.textContent = this.value + '%';
                });
            }
        });
    </script>
{% endblock %}
