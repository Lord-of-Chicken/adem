<header class="site-header">
    <div class="site-header__inner">
        <a href="{{ path('app_home') }}" class="site-brand" data-turbo="false">
            {% if logoAsset %}
                <img class="site-brand__logo" src="{{ asset(logoAsset) }}" alt="" width="128" height="128" fetchpriority="high" decoding="async">
            {% endif %}
        </a>

        <button class="site-header__menu-toggle" id="menuToggle" aria-expanded="false" aria-label="{{ 'nav.menu'|trans }}">
            <span class="site-header__menu-toggle__line"></span>
            <span class="site-header__menu-toggle__line"></span>
            <span class="site-header__menu-toggle__line"></span>
        </button>

        <nav class="site-nav" aria-label="{{ 'nav.main_navigation'|trans }}">
            {% for link in navLinks %}
                <a href="{{ link.href }}" class="site-nav__link">{{ link.label }}</a>
            {% endfor %}
            <a href="{{ path('app_about') }}" class="site-nav__link{% if app.current_route == 'app_about' %} site-nav__link--active{% endif %}">{{ 'nav.about'|trans }}</a>
            <a href="{{ path('app_faq') }}" class="site-nav__link{% if app.current_route == 'app_faq' %} site-nav__link--active{% endif %}">{{ 'nav.faq'|trans }}</a>
            <a href="{{ path('app_press') }}" class="site-nav__link{% if app.current_route == 'app_press' %} site-nav__link--active{% endif %}">{{ 'nav.press'|trans }}</a>
            <a href="{{ path('app_contact') }}" class="site-nav__link{% if app.current_route == 'app_contact' %} site-nav__link--active{% endif %}">{{ 'nav.contact'|trans }}</a>

            <div class="site-header__account site-header__account--mobile">
                <div class="lang-inline">
                    <a href="{{ path('app_locale_switch', { locale: 'fr' }) }}" class="lang-inline__item{% if app.request.locale == 'fr' %} lang-inline__item--active{% endif %}" lang="fr" title="{{ 'lang.fr'|trans }}">{{ include('_partials/flags/fr.svg.twig') }} FR</a>
                    <a href="{{ path('app_locale_switch', { locale: 'en' }) }}" class="lang-inline__item{% if app.request.locale == 'en' %} lang-inline__item--active{% endif %}" lang="en" title="{{ 'lang.en'|trans }}">{{ include('_partials/flags/gb.svg.twig') }} EN</a>
                    <a href="{{ path('app_locale_switch', { locale: 'nl' }) }}" class="lang-inline__item{% if app.request.locale == 'nl' %} lang-inline__item--active{% endif %}" lang="nl" title="{{ 'lang.nl'|trans }}">{{ include('_partials/flags/nl.svg.twig') }} NL</a>
                </div>
                <a href="{{ cartUrl }}" class="site-nav__link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    {{ 'nav.cart'|trans }}
                    {% if cartLineCount is defined and cartLineCount > 0 %}
                        <span class="site-header__cart-badge">{{ cartLineCount }}</span>
                    {% endif %}
                </a>

                {% if isAuthenticated %}
                    <a href="{{ profileUrl }}" class="site-nav__link">{{ 'profile.title'|trans }}</a>
                {% else %}
                    <a href="{{ loginUrl }}" class="site-nav__link" aria-label="{{ 'nav.login'|trans }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </a>
                {% endif %}
            </div>
        </nav>

        <div class="site-header__account site-header__account--desktop">
            <a href="{{ cartUrl }}" class="site-header__cart">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                {{ 'nav.cart'|trans }}
                {% if cartLineCount is defined and cartLineCount > 0 %}
                    <span class="site-header__cart-badge">{{ cartLineCount }}</span>
                {% endif %}
            </a>

            {% if isAdmin %}
                <a href="{{ adminUrl }}" class="site-nav__link" data-turbo="false">{{ 'nav.admin'|trans }}</a>
            {% endif %}

            {% if isAuthenticated %}
                <a href="{{ profileUrl }}" class="site-nav__link">{{ 'profile.title'|trans }}</a>
            {% else %}
                <a href="{{ loginUrl }}" class="site-nav__link" aria-label="{{ 'nav.login'|trans }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </a>
            {% endif %}

            <div class="lang-dropdown">
                <button class="lang-dropdown__toggle" aria-expanded="false" aria-haspopup="true" aria-label="{{ 'lang.choose'|trans }}">
                    {% if app.request.locale == 'fr' %}{{ include('_partials/flags/fr.svg.twig') }}{% elseif app.request.locale == 'nl' %}{{ include('_partials/flags/nl.svg.twig') }}{% else %}{{ include('_partials/flags/gb.svg.twig') }}{% endif %}
                    <svg class="lang-dropdown__arrow" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="lang-dropdown__menu" hidden>
                    <a href="{{ path('app_locale_switch', { locale: 'fr' }) }}" class="lang-dropdown__item{% if app.request.locale == 'fr' %} lang-dropdown__item--active{% endif %}" lang="fr">{{ include('_partials/flags/fr.svg.twig') }} {{ 'lang.fr'|trans }}</a>
                    <a href="{{ path('app_locale_switch', { locale: 'en' }) }}" class="lang-dropdown__item{% if app.request.locale == 'en' %} lang-dropdown__item--active{% endif %}" lang="en">{{ include('_partials/flags/gb.svg.twig') }} {{ 'lang.en'|trans }}</a>
                    <a href="{{ path('app_locale_switch', { locale: 'nl' }) }}" class="lang-dropdown__item{% if app.request.locale == 'nl' %} lang-dropdown__item--active{% endif %}" lang="nl">{{ include('_partials/flags/nl.svg.twig') }} {{ 'lang.nl'|trans }}</a>
                </div>
            </div>
        </div>
    </div>
</header>
