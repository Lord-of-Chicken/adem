{% extends 'layout/street.html.twig' %}

{% block title %}{{ 'legal.cookies.title'|trans }} | {{ site_brand.title }}{% endblock %}

{% block meta_description %}{{ 'legal.cookies.meta_description'|trans }}{% endblock %}
{% block og_title %}{{ 'legal.cookies.title'|trans }} | {{ site_brand.title }}{% endblock %}
{% block og_description %}{{ 'legal.cookies.meta_description'|trans }}{% endblock %}
{% block og_image %}{{ absolute_url(asset('img/Social/og-home-preview.jpg')) }}{% endblock %}

{% block head %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "{{ 'legal.cookies.title'|trans|e('js') }}",
        "description": "{{ 'legal.cookies.meta_description'|trans|e('js') }}",
        "url": "{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}",
        "inLanguage": "{{ app.request.locale }}",
        "isPartOf": {
            "@type": "WebSite",
            "name": "{{ site_brand.title|e('js') }}",
            "url": "{{ url('app_home') }}"
        },
        "breadcrumb": {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "{{ 'nav.home'|trans|e('js') }}", "item": "{{ url('app_home') }}" },
                { "@type": "ListItem", "position": 2, "name": "{{ 'legal.cookies.title'|trans|e('js') }}", "item": "{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}" }
            ]
        }
    }
    </script>
{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    <section class="section section--auth">
        <div class="section__inner section__inner--narrow legal-page">
            <h1 class="section__title section__title--tag">{{ 'legal.cookies.title'|trans }}</h1>
            <p class="legal-page__updated">{{ 'legal.last_updated'|trans }}</p>

            <div class="card legal-page__body">
                <p class="section__intro">{{ 'legal.cookies.intro'|trans }}</p>

                {# Essentiels #}
                <h2 class="card__title">{{ 'legal.cookies.essential_title'|trans }}</h2>
                <p>{{ 'legal.cookies.essential_text'|trans }}</p>
                <ul class="legal-page__list">
                    <li>{{ 'legal.cookies.essential_session'|trans|raw }}</li>
                    <li>{{ 'legal.cookies.essential_csrf'|trans|raw }}</li>
                    <li>{{ 'legal.cookies.essential_consent'|trans|raw }}</li>
                </ul>

                {# Analytics #}
                <h2 class="card__title">{{ 'legal.cookies.analytics_title'|trans }}</h2>
                <p>{{ 'legal.cookies.analytics_text'|trans }}</p>
                <ul class="legal-page__list">
                    <li>{{ 'legal.cookies.analytics_ga'|trans|raw }}</li>
                </ul>

                {# Paiement #}
                <h2 class="card__title">{{ 'legal.cookies.payment_title'|trans }}</h2>
                <p>{{ 'legal.cookies.payment_text'|trans }}</p>
                <ul class="legal-page__list">
                    <li>{{ 'legal.cookies.payment_stripe'|trans|raw }}</li>
                </ul>

                {# Révocation #}
                <h2 class="card__title">{{ 'legal.cookies.revoke_title'|trans }}</h2>
                <p>{{ 'legal.cookies.revoke_text'|trans }}</p>
                <p>
                    <button type="button" class="btn btn--primary" data-action="cookie-consent#openPreferences">
                        {{ 'cookie.manage'|trans }}
                    </button>
                </p>
            </div>

            <p class="legal-page__nav">
                <a href="{{ path('app_privacy') }}">{{ 'nav.privacy'|trans }}</a>
                &middot;
                <a href="{{ path('app_legal_mentions') }}">{{ 'nav.legal_mentions'|trans }}</a>
            </p>
        </div>
    </section>
</div>
{% endblock %}
