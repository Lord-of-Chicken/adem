{% extends 'layout/street.html.twig' %}

{% block title %}{{ 'legal.privacy.title'|trans }} | {{ site_brand.title }}{% endblock %}

{% block meta_description %}{{ 'legal.privacy.meta_description'|trans }}{% endblock %}
{% block og_title %}{{ 'legal.privacy.title'|trans }} | {{ site_brand.title }}{% endblock %}
{% block og_description %}{{ 'legal.privacy.meta_description'|trans }}{% endblock %}
{% block og_image %}{{ absolute_url(asset('img/Social/og-home-preview.jpg')) }}{% endblock %}

{% block head %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "{{ 'legal.privacy.title'|trans|e('js') }}",
        "description": "{{ 'legal.privacy.meta_description'|trans|e('js') }}",
        "url": "{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}",
        "inLanguage": "{{ app.request.locale }}",
        "isPartOf": {
            "@type": "WebSite",
            "name": "{{ site_brand.title|e('js') }}",
            "url": "{{ url('app_home') }}"
        },
        "breadcrumb": {
            "@type": "BreadcrumbList",
            "itemListElement": [
                { "@type": "ListItem", "position": 1, "name": "{{ 'nav.home'|trans|e('js') }}", "item": "{{ url('app_home') }}" },
                { "@type": "ListItem", "position": 2, "name": "{{ 'legal.privacy.title'|trans|e('js') }}", "item": "{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}" }
            ]
        }
    }
    </script>
{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    <section class="section section--auth">
        <div class="section__inner section__inner--narrow legal-page">
            <h1 class="section__title section__title--tag">{{ 'legal.privacy.title'|trans }}</h1>
            <p class="legal-page__updated">{{ 'legal.last_updated'|trans }}</p>

            <div class="card legal-page__body">
                <p class="section__intro">{{ 'legal.privacy.intro'|trans }}</p>

                {# 1. Responsable du traitement #}
                <h2 class="card__title">{{ 'legal.privacy.controller_title'|trans }}</h2>
                <p>
                    {# Placeholder à compléter par l'éditeur — voir clé legal.privacy.controller_placeholder #}
                    <strong>{{ 'legal.privacy.controller_placeholder'|trans }}</strong>
                </p>
                <p>
                    <strong>{{ 'legal.privacy.dpo_placeholder'|trans }}</strong>
                </p>

                {# 2. Finalités du traitement #}
                <h2 class="card__title">{{ 'legal.privacy.purposes_title'|trans }}</h2>
                <p>{{ 'legal.privacy.purposes_intro'|trans }}</p>
                <ul class="legal-page__list">
                    <li>{{ 'legal.privacy.purposes_account'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.purposes_newsletter'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.purposes_payment'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.purposes_contact'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.purposes_gallery'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.purposes_analytics'|trans|raw }}</li>
                </ul>

                {# 3. Base légale #}
                <h2 class="card__title">{{ 'legal.privacy.legal_basis_title'|trans }}</h2>
                <ul class="legal-page__list">
                    <li>{{ 'legal.privacy.basis_contract'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.basis_consent'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.basis_legal'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.basis_interest'|trans|raw }}</li>
                </ul>

                {# 4. Durées de conservation #}
                <h2 class="card__title">{{ 'legal.privacy.retention_title'|trans }}</h2>
                <ul class="legal-page__list">
                    <li>{{ 'legal.privacy.retention_invoicing'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.retention_newsletter'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.retention_contact'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.retention_account'|trans|raw }}</li>
                </ul>

                {# 5. Destinataires & transferts #}
                <h2 class="card__title">{{ 'legal.privacy.recipients_title'|trans }}</h2>
                <p>{{ 'legal.privacy.recipients_intro'|trans }}</p>
                <ul class="legal-page__list">
                    <li>{{ 'legal.privacy.recipients_stripe'|trans|raw }}</li>
                    <li>
                        {# Placeholder à compléter par l'éditeur — voir clé legal.privacy.recipients_host_placeholder #}
                        <strong>{{ 'legal.privacy.recipients_host_placeholder'|trans }}</strong>
                    </li>
                    <li>{{ 'legal.privacy.recipients_analytics'|trans|raw }}</li>
                </ul>

                {# 6. Droits RGPD #}
                <h2 class="card__title">{{ 'legal.privacy.rights_title'|trans }}</h2>
                <p>{{ 'legal.privacy.rights_intro'|trans }}</p>
                <ul class="legal-page__list">
                    <li>{{ 'legal.privacy.rights_access'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.rights_rectification'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.rights_erasure'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.rights_portability'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.rights_objection'|trans|raw }}</li>
                    <li>{{ 'legal.privacy.rights_withdraw'|trans|raw }}</li>
                </ul>
                <p>
                    {{ 'legal.privacy.rights_exercise'|trans }}
                    {# Placeholder à compléter par l'éditeur — voir clé legal.privacy.rights_exercise_placeholder #}
                    <strong>{{ 'legal.privacy.rights_exercise_placeholder'|trans }}</strong>.
                </p>
                <p>
                    {{ 'legal.privacy.rights_complaint'|trans|raw }}
                    <a href="https://www.autoriteprotectiondonnees.be" rel="noopener noreferrer" target="_blank">autoriteprotectiondonnees.be</a>.
                </p>

                {# 7. Cookies #}
                <h2 class="card__title">{{ 'legal.privacy.cookies_title'|trans }}</h2>
                <p>
                    {{ 'legal.privacy.cookies_text'|trans }}
                    <a href="{{ path('app_cookies_policy') }}">{{ 'nav.cookies_policy'|trans }}</a>.
                </p>
            </div>

            <p class="legal-page__nav">
                <a href="{{ path('app_legal_mentions') }}">{{ 'nav.legal_mentions'|trans }}</a>
                &middot;
                <a href="{{ path('app_cookies_policy') }}">{{ 'nav.cookies_policy'|trans }}</a>
            </p>
        </div>
    </section>
</div>
{% endblock %}
