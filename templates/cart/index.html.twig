{% extends 'layout/street.html.twig' %}

{% block title %}Panier participations | La Ruelle d’Adem{% endblock %}

{% block street_main %}
<main class="main main--narrow">
    <section class="section">
        <div class="section__inner">
            <h1 class="section__title section__title--tag">Panier</h1>
            <p class="section__intro">Récapitulatif de tes participations (paiement à brancher ensuite).</p>

            {% if lines is empty %}
                <p class="section__hint">Ton panier est vide. <a href="{{ path('app_home') }}#offres">Voir les offres</a></p>
            {% else %}
                <ul class="cart-list">
                    {% for row in lines %}
                        {% set line = row.line %}
                        {% set tier = row.tier %}
                        <li class="cart-line card card--sticker">
                            <div class="cart-line__main">
                                <h2 class="cart-line__title">{{ tier.title }}</h2>
                                <p class="cart-line__meta">
                                    Qté : {{ line.quantity }}
                                    {% if line.donor_name %}
                                        · Nom affiché : {{ line.donor_name }}
                                    {% endif %}
                                </p>
                                <p class="cart-line__price">{{ catalog.formatEurosFromCents(row.line_total_cents) }}&nbsp;€</p>
                            </div>
                            <div class="cart-line__actions">
                                {% if tier.priced_per_unit %}
                                    <div class="qty-controls">
                                        <form class="qty-form" method="post" action="{{ path('app_cart_quantity', { lineId: line.line_id }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('cart_quantity') }}">
                                            <input type="hidden" name="quantity" value="{{ line.quantity - 1 }}" class="qty-input-hidden">
                                            <button type="submit" 
                                                    class="qty-btn qty-btn--minus" 
                                                    {% if line.quantity <= tier.min_qty %}disabled{% endif %}
                                                    aria-label="Diminuer la quantité">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M5 12h14"/>
                                                </svg>
                                            </button>
                                        </form>
                                        
                                        <div class="qty-display">
                                            <span class="qty-number">{{ line.quantity }}</span>
                                            <span class="qty-label">pièce{% if line.quantity > 1 %}s{% endif %}</span>
                                        </div>
                                        
                                        <form class="qty-form" method="post" action="{{ path('app_cart_quantity', { lineId: line.line_id }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('cart_quantity') }}">
                                            <input type="hidden" name="quantity" value="{{ line.quantity + 1 }}" class="qty-input-hidden">
                                            <button type="submit" 
                                                    class="qty-btn qty-btn--plus" 
                                                    {% if line.quantity >= tier.max_qty %}disabled{% endif %}
                                                    aria-label="Augmenter la quantité">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M12 5v14M5 12h14"/>
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                {% endif %}
                                <form method="post" action="{{ path('app_cart_remove', { lineId: line.line_id }) }}" onsubmit="return confirm('Retirer cette ligne ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_remove') }}">
                                    <button type="submit" class="site-header__link-btn">Retirer</button>
                                </form>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
                <p class="cart-total"><strong>Total estimé : {{ catalog.formatEurosFromCents(total_cents) }}&nbsp;€</strong></p>
                
                <div class="cart-actions">
                    <a href="{{ path('app_checkout') }}" class="btn btn--primary btn--large">
                        Procéder au paiement
                    </a>
                </div>
            {% endif %}
        </div>
    </section>
</main>
{% endblock %}
