{% extends 'layout/street.html.twig' %}

{% block title %}{{ 'cart.title'|trans }} | {{ site_brand.title }}{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    {# Jeton CSRF pour les mises à jour de quantité en AJAX #}
    <input type="hidden" id="cart-csrf-token" value="{{ csrf_token('cart_quantity') }}">

    <section class="section">
        <div class="section__inner">
            <h1 class="section__title section__title--tag">{{ page.title }}</h1>

            {% if lines is empty %}
                <p class="section__hint">{{ 'cart.empty'|trans }} <a href="{{ path('app_home') }}#offres">{{ page.empty_link }}</a></p>
            {% else %}
                <ul class="cart-list">
                    {% for row in lines %}
                        {% set line = row.line %}
                        {% set tier = row.tier %}
                        
                        <li class="cart-line card card--sticker">
                            <div class="cart-line__main">
                                <h2 class="cart-line__title">{{ tier.title }}</h2>
                                <div class="cart-line__meta">
                                    <p>{{ 'cart.qty'|trans }} : <span id="display-qty-{{ line.line_id }}">{{ line.quantity }}</span></p>
                                    {% if line.donor_name %}
                                        <p><strong>{{ 'cart.donor'|trans }} :</strong> {{ line.donor_name }}</p>
                                    {% endif %}
                                    {% if line.custom_price_cents %}
                                        <p><strong>{{ 'cart.free_amount'|trans }} :</strong> {{ (line.custom_price_cents / 100)|number_format(2, ',', ' ') }}&nbsp;€</p>
                                    {% endif %}
                                </div>
                                <p class="cart-line__price">
                                    <span id="line-total-{{ line.line_id }}">{{ catalog.formatEurosFromCents(row.line_total_cents) }}</span>&nbsp;€
                                </p>
                            </div>

                            <div class="cart-line__actions">
                                <div class="qty-controls">
                                    <button type="button" class="qty-btn" 
                                            id="btn-minus-{{ line.line_id }}"
                                            onclick="updateCartQty('{{ line.line_id }}', -1, {{ tier.min_qty|default(1) }}, {{ tier.max_qty|default(500) }})"
                                            {% if line.quantity <= tier.min_qty|default(1) %}disabled{% endif %}>
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/></svg>
                                    </button>

                                    <div class="qty-display">
                                        <span class="qty-number" id="number-{{ line.line_id }}">{{ line.quantity }}</span>
                                        <span class="qty-label" id="label-{{ line.line_id }}" data-piece-singular="{{ 'cart.piece'|trans }}" data-piece-plural="{{ 'cart.pieces'|trans }}"></span>
                                    </div>

                                    <button type="button" class="qty-btn" 
                                            id="btn-plus-{{ line.line_id }}"
                                            onclick="updateCartQty('{{ line.line_id }}', 1, {{ tier.min_qty|default(1) }}, {{ tier.max_qty|default(500) }})"
                                            {% if line.quantity >= tier.max_qty|default(500) %}disabled{% endif %}>
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                                    </button>
                                </div>

                                <form method="post" action="{{ path('app_cart_remove', { lineId: line.line_id }) }}" data-confirm-title="{{ 'cart.remove_confirm_title'|trans }}" data-confirm-message="{{ 'cart.remove_confirm_message'|trans }}" data-confirm-confirm-label="{{ 'cart.remove_confirm_btn'|trans }}" data-confirm-cancel-label="{{ 'profile.cancel'|trans }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_remove') }}">
                                    <button type="submit" class="btn--remove">{{ page.remove_btn }}</button>
                                </form>
                            </div>
                        </li>
                    {% endfor %}
                </ul>

                <div class="cart-summary card">
                    <p class="cart-total">
                        <strong>{{ 'cart.total'|trans }} : <span id="cart-total-display">{{ catalog.formatEurosFromCents(total_cents) }}</span>&nbsp;€</strong>
                    </p>

                    <div class="cart-actions">
                        <form method="post" action="{{ path('app_cart_clear') }}" class="display-inline-block" data-confirm-title="{{ 'cart.clear_confirm_title'|trans }}" data-confirm-message="{{ 'cart.clear_confirm_message'|trans }}" data-confirm-confirm-label="{{ 'cart.clear_confirm_btn'|trans }}" data-confirm-cancel-label="{{ 'profile.cancel'|trans }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('cart_clear') }}">
                            <button type="submit" class="btn btn--secondary">{{ page.clear_btn }}</button>
                        </form>

                        {# Lien direct vers le checkout PHP #}
                        <a href="{{ path('app_checkout') }}" class="btn btn--primary">
                            {{ 'cart.checkout_btn'|trans }}
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module">
        import '/assets/js/cart.js';
    </script>
{% endblock %}

