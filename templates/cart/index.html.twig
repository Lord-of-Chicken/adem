{% extends 'layout/street.html.twig' %}

{% block title %}Panier participations | La Ruelle d’Adem{% endblock %}

{% block street_main %}
<main class="main main--narrow">
    <section class="section">
        <div class="section__inner">
            <h1 class="section__title section__title--tag">Panier</h1>

            {% if lines is empty %}
                <p class="section__hint">Ton panier est vide. <a href="{{ path('app_home') }}#offres">Voir les offres</a></p>
            {% else %}
                <ul class="cart-list">
                    {% for row in lines %}
                        {% set line = row.line %}
                        {% set tier = row.tier %}
                        
                        {# CONFIGURATION STIMULUS PAR LIGNE #}
                        <li class="cart-line card card--sticker" 
                            data-controller="cart-quantity"
                            data-cart-quantity-quantity-value="{{ line.quantity }}"
                            data-cart-quantity-update-url-value="{{ path('app_cart_quantity', { lineId: line.line_id }) }}"
                            data-cart-quantity-csrf-token-value="{{ csrf_token('cart_quantity') }}"
                            data-cart-quantity-min-value="{{ tier.min_qty|default(1) }}"
                            data-cart-quantity-max-value="{{ tier.max_qty|default(500) }}">

                            <div class="cart-line__main">
                                <h2 class="cart-line__title">{{ tier.title }}</h2>
                                <p class="cart-line__meta">
                                    Qté : <span data-cart-quantity-target="display">{{ line.quantity }}</span>
                                    {% if line.donor_name %}
                                        · Nom : {{ line.donor_name }}
                                    {% endif %}
                                </p>
                                <p class="cart-line__price">
                                    <span data-cart-quantity-target="linePrice">{{ catalog.formatEurosFromCents(row.line_total_cents) }}</span>&nbsp;€
                                </p>
                            </div>

                            <div class="cart-line__actions">
                                <div class="qty-controls">
                                    <button type="button" class="qty-btn" 
                                            data-action="click->cart-quantity#minus"
                                            data-cart-quantity-target="minusBtn"
                                            {% if line.quantity <= tier.min_qty %}disabled{% endif %}>
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/></svg>
                                    </button>

                                    <div class="qty-display">
                                        <span class="qty-number" data-cart-quantity-target="display">{{ line.quantity }}</span>
                                        <span class="qty-label" data-cart-quantity-target="label">pièce{{ line.quantity > 1 ? 's' : '' }}</span>
                                    </div>

                                    <button type="button" class="qty-btn" 
                                            data-action="click->cart-quantity#plus"
                                            data-cart-quantity-target="plusBtn"
                                            {% if line.quantity >= tier.max_qty %}disabled{% endif %}>
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                                    </button>
                                </div>

                                <form method="post" action="{{ path('app_cart_remove', { lineId: line.line_id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cart_remove') }}">
                                    <button type="submit" class="site-header__link-btn">Retirer</button>
                                </form>
                            </div>
                        </li>
                    {% endfor %}
                </ul>

                <p class="cart-total">
                    <strong>Total estimé : <span id="cart-total-display">{{ catalog.formatEurosFromCents(total_cents) }}</span>&nbsp;€</strong>
                </p>
                
                <div class="cart-actions">
                    <a href="{{ path('app_checkout') }}" class="btn btn--primary btn--large">Procéder au paiement</a>
                </div>
            {% endif %}
        </div>
    </section>
</main>
{% endblock %}