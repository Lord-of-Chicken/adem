<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}La Ruelle d’Adem{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Permanent+Marker&family=Rubik:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌸</text></svg>">
    {% block stylesheets %}
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% if app.current_route starts with 'app_checkout' or app.current_route starts with 'app_payment' or app.current_route starts with 'app_cart' %}
            <script src="https://js.stripe.com/v3/"></script>
            <script>
                window.STRIPE_PUBLISHABLE_KEY = '{{ stripe_publishable_key }}';

                function initStripe() {
                    if (typeof Stripe !== 'undefined' && window.STRIPE_PUBLISHABLE_KEY && window.STRIPE_PUBLISHABLE_KEY !== '') {
                        try {
                            window.stripe = Stripe(window.STRIPE_PUBLISHABLE_KEY);
                        } catch (error) {
                        }
                    } else {
                        setTimeout(initStripe, 100);
                    }
                }

                document.addEventListener('DOMContentLoaded', initStripe);
            </script>
        {% endif %}
    {% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    {# Bandeau chantier #}
    <div class="construction-banner">
        <div class="construction-banner__text">🚧 SITE EN CHANTIER - TRAVAUX EN COURS 🚧</div>
    </div>

    {% block body %}{% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
    <script>
        /* ── Layout: measure banner + header, set CSS vars ── */
        (function(){
            function updateLayout(){
                var b = document.querySelector('.construction-banner');
                var h = document.querySelector('.site-header');
                var r = document.documentElement.style;
                if(b) r.setProperty('--banner-h', b.offsetHeight+'px');
                if(h) r.setProperty('--header-h', h.offsetHeight+'px');
            }
            document.addEventListener('DOMContentLoaded', updateLayout);
            window.addEventListener('load', updateLayout);
            window.addEventListener('resize', updateLayout);
            if(document.fonts && document.fonts.ready) document.fonts.ready.then(updateLayout);
        })();

        /* ── Menu toggle (shared across all layouts) ── */
        document.addEventListener('DOMContentLoaded', function(){
            var menuToggle = document.getElementById('menuToggle');
            var siteNav = document.querySelector('.site-nav');
            if(menuToggle && siteNav){
                menuToggle.addEventListener('click', function(e){
                    e.stopPropagation();
                    var isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
                    menuToggle.setAttribute('aria-expanded', !isExpanded);
                    siteNav.classList.toggle('site-nav--open', !isExpanded);
                });
                document.addEventListener('click', function(e){
                    if(!menuToggle.contains(e.target) && !siteNav.contains(e.target)){
                        menuToggle.setAttribute('aria-expanded','false');
                        siteNav.classList.remove('site-nav--open');
                    }
                });
                document.addEventListener('keydown', function(e){
                    if(e.key==='Escape'){
                        menuToggle.setAttribute('aria-expanded','false');
                        siteNav.classList.remove('site-nav--open');
                    }
                });
            }

            /* ── Swiper init ── */
            var mediaSwiper = new Swiper('.media-swiper', {
                effect: 'coverflow',
                grabCursor: true,
                centeredSlides: true,
                slidesPerView: 'auto',
                coverflowEffect: { rotate:50, stretch:0, depth:100, modifier:1, slideShadows:true },
                autoplay: { delay:3000, disableOnInteraction:false },
                pagination: { el:'.swiper-pagination', clickable:true },
                navigation: { nextEl:'.swiper-button-next', prevEl:'.swiper-button-prev' },
            });
        });
    </script>
</body>
</html>
