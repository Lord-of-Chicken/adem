{% extends 'layout/street.html.twig' %}

{% block title %}Inscription | {{ site_brand.title }}{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    <section class="section section--auth">
        <div class="section__inner section__inner--narrow">
            <h1 class="section__title section__title--tag">{{ page.title }}</h1>
            <p class="section__intro">{{ page.intro }}</p>

            <div class="card">
                {{ form_start(registrationForm, { attr: { class: 'form' } }) }}
                {{ form_row(registrationForm.firstName, { row_attr: { class: 'form__field' }, attr: { class: 'form__input' } }) }}
                {{ form_row(registrationForm.lastName, { row_attr: { class: 'form__field' }, attr: { class: 'form__input' } }) }}
                {{ form_row(registrationForm.email, { row_attr: { class: 'form__field' }, attr: { class: 'form__input' } }) }}
                <div class="form__field">
                    {{ form_widget(registrationForm.newsletter) }}
                    {{ form_label(registrationForm.newsletter) }}
                </div>
                <div class="form__field">
                    {{ form_widget(registrationForm.ageConfirmed) }}
                    {{ form_label(registrationForm.ageConfirmed) }}
                    {{ form_errors(registrationForm.ageConfirmed) }}
                </div>
                <button type="submit" class="btn btn--primary">{{ page.submit }}</button>
            {{ form_end(registrationForm) }}
            </div>

        </div>
    </section>
</div>
{% endblock %}
