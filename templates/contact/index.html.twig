{% extends 'layout/street.html.twig' %}

{% block title %}{{ page.title }} | {{ site_brand.title }}{% endblock %}
{% block meta_description %}{{ 'contact.intro'|trans }}{% endblock %}
{% block og_title %}{{ page.title }} | {{ site_brand.title }}{% endblock %}
{% block og_description %}{{ 'contact.intro'|trans }}{% endblock %}
{% block og_image %}{{ absolute_url(asset('img/Social/og-home-preview.png')) }}{% endblock %}

{% block head %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ContactPage",
        "name": "{{ page.title|e('js') }}",
        "description": "{{ 'contact.intro'|trans|e('js') }}",
        "url": "{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}",
        "mainEntity": {
            "@type": "Organization",
            "name": "{{ site_brand.title|e('js') }}",
            "url": "{{ url('app_home') }}"
        }
    }
    </script>
{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    <section class="section section--auth">
        <div class="section__inner section__inner--narrow">
            <h1 class="section__title section__title--tag">{{ page.title }}</h1>
            <p class="section__intro">{{ page.intro }}</p>

            {{ form_start(form, {'attr': {'class': 'form form--stack'}}) }}
                {{ form_row(form.name) }}
                {{ form_row(form.email) }}
                {{ form_row(form.message, { attr: { rows: 6 } }) }}
                <div class="form-actions">
                    <button type="submit" class="btn btn--primary btn--full">{{ page.submit }}</button>
                </div>
            {{ form_end(form) }}
        </div>
    </section>
</div>
{% endblock %}