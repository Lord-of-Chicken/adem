{% extends 'layout/street.html.twig' %}

{% block title %}Contact | La Ruelle d'Adem{% endblock %}

{% block street_main %}
<main class="main main--narrow">
    <section class="section section--auth">
        <div class="section__inner section__inner--narrow">
            <h1 class="section__title section__title--tag">Contactez-nous</h1>
            <p class="section__intro">Une question ? Une suggestion ? N'hésitez pas à nous envoyer un message.</p>

            {# Affichage des messages flash avec VOS classes CSS existantes #}
            {% for message in app.flashes('success') %}
                <div class="flash flash--success">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="flash flash--danger">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="card">
                {{ form_start(form, {'attr': {'class': 'form'}}) }}

                {{ form_row(form.name, { row_attr: { class: 'form__field' }, attr: { class: 'form__input' } }) }}
                {{ form_row(form.email, { row_attr: { class: 'form__field' }, attr: { class: 'form__input' } }) }}
                {{ form_row(form.message, { row_attr: { class: 'form__field' }, attr: { class: 'form__input', 'rows': '6' } }) }}

                <button type="submit" class="btn btn--primary">Envoyer le message</button>

                {{ form_end(form) }}
            </div>
        </div>
    </section>
</main>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form__label {
            margin-top: 0.5rem;
        }

        textarea.form__input {
            resize: vertical;
            min-height: 120px;
        }

        .form-error-icon,
        .form-error-message {
            color: #b00020;
            font-size: 0.85rem;
            margin-top: 0.25rem;
        }

        /* Ajustement pour les messages flash dans cette section */
        .section--auth .flash {
            margin: 0 0 1.5rem 0;
            border-radius: 4px;
        }
    </style>
{% endblock %}