{% extends 'layout/street.html.twig' %}

{% block title %}Réinitialiser le mot de passe | La Ruelle d'Adem{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    <section class="section section--auth">
        <div class="section__inner section__inner--narrow">
            <h1 class="section__title section__title--tag">{{ page.title }}</h1>
            <p class="section__intro">{{ page.intro }}</p>

            <div class="card">
                {{ form_start(resetForm, { attr: { class: 'form' } }) }}
                {{ form_row(resetForm.plainPassword.first, { row_attr: { class: 'form__field' }, attr: { class: 'form__input' } }) }}
                {{ form_row(resetForm.plainPassword.second, { row_attr: { class: 'form__field' }, attr: { class: 'form__input' } }) }}
                <button type="submit" class="btn btn--primary btn--submit-spacing">{{ page.submit }}</button>
            {{ form_end(resetForm) }}
            </div>

            <p class="section__hint"><a href="{{ path('app_login') }}">{{ page.back_link }}</a></p>
        </div>
    </section>
</div>
{% endblock %}
