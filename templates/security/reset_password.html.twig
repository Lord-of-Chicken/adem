{% extends 'layout/street.html.twig' %}

{% block title %}Réinitialiser le mot de passe | La Ruelle d'Adem{% endblock %}

{% block street_main %}
<main class="main main--narrow">
    <section class="section section--auth">
        <div class="section__inner section__inner--narrow">
            <h1 class="section__title section__title--tag">Nouveau mot de passe</h1>
            <p class="section__intro">Choisis ton nouveau mot de passe.</p>

            {% for flash in app.flashes('success') %}
                <div class="flash flash--success" role="alert">{{ flash }}</div>
            {% endfor %}

            {% for flash in app.flashes('danger') %}
                <div class="flash flash--danger" role="alert">{{ flash }}</div>
            {% endfor %}

            {{ form_start(resetForm, { attr: { class: 'form form--stack' } }) }}
                {{ form_row(resetForm.plainPassword.first, { row_attr: { class: 'form__field' }, attr: { class: 'form__input' } }) }}
                {{ form_row(resetForm.plainPassword.second, { row_attr: { class: 'form__field' }, attr: { class: 'form__input' } }) }}
                <button type="submit" class="btn btn--primary">Réinitialiser</button>
            {{ form_end(resetForm) }}

            <p class="section__hint"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
        </div>
    </section>
</main>
{% endblock %}
