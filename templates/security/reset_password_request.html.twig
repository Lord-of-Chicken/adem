{% extends 'layout/street.html.twig' %}

{% block title %}Réinitialiser le mot de passe | La Ruelle d'Adem{% endblock %}

{% block street_main %}
<main class="main main--narrow">
    <section class="section section--auth">
        <div class="section__inner section__inner--narrow">
            <h1 class="section__title section__title--tag">Réinitialiser le mot de passe</h1>
            <p class="section__intro">Entrez votre adresse e-mail pour recevoir un lien de réinitialisation.</p>

            {% for flash in app.flashes('success') %}
                <div class="flash flash--success" role="alert">{{ flash }}</div>
            {% endfor %}

            {% for flash in app.flashes('danger') %}
                <div class="flash flash--danger" role="alert">{{ flash }}</div>
            {% endfor %}

            <div class="card">
                {{ form_start(requestForm, { attr: { class: 'form' } }) }}
                {{ form_row(requestForm.email, { row_attr: { class: 'form__field' }, attr: { class: 'form__input' } }) }}
                <button type="submit" class="btn btn--primary">Envoyer le lien</button>
            {{ form_end(requestForm) }}
            </div>

            <p class="section__hint"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
        </div>
    </section>
</main>
{% endblock %}
