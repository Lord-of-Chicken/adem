{% extends 'layout/street.html.twig' %}

{% block title %}{{ 'nav.login'|trans }} | {{ site_brand.title }}{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    <section class="section section--auth">
        <div class="section__inner section__inner--narrow">
            <h1 class="section__title section__title--tag">{{ page.title }}</h1>
            <p class="section__intro">{{ page.intro }}</p>

            {% if error %}
                <div class="flash flash--danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form class="form form--stack" method="post" action="{{ path('app_login') }}">
                <div class="form__field">
                    <label class="form__label" for="inputEmail">E-mail</label>
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="inputEmail"
                        class="form__input"
                        autocomplete="email"
                        required
                        autofocus
                    >
                </div>
                <div class="form__field">
                    <label class="form__label" for="inputPassword">Mot de passe</label>
                    <input
                        type="password"
                        name="_password"
                        id="inputPassword"
                        class="form__input"
                        autocomplete="current-password"
                        required
                    >
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <div class="form-actions">
                    <button class="btn btn--primary btn--full" type="submit">{{ page.submit }}</button>
                </div>
            </form>

            <div class="form-hints">
                <p class="section__hint"><a href="{{ path('app_forgot_password_request') }}">{{ page.forgot_link }}</a></p>
                <p class="section__hint">{{ page.register_hint }} <a href="{{ path('app_register') }}">{{ page.register_link }}</a></p>
            </div>
        </div>
    </section>
</div>
{% endblock %}
