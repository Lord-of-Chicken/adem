{% extends 'layout/street.html.twig' %}

{% block title %}Connexion | La Ruelle d’Adem{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    <section class="section section--auth">
        <div class="section__inner section__inner--narrow">
            <h1 class="section__title section__title--tag">Connexion</h1>
            <p class="section__intro">Connecte-toi pour gérer ton panier de participations.</p>

            {% if error %}
                <div class="flash flash--danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <div class="card">
                <form class="form" method="post" action="{{ path('app_login') }}">
                <div class="form__field">
                    <label class="form__label" for="inputEmail">E-mail</label>
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="inputEmail"
                        class="form__input"
                        autocomplete="email"
                        required
                        autofocus
                    >
                </div>
                <div class="form__field">
                    <label class="form__label" for="inputPassword">Mot de passe</label>
                    <input
                        type="password"
                        name="_password"
                        id="inputPassword"
                        class="form__input"
                        autocomplete="current-password"
                        required
                    >
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="btn btn--primary" type="submit">Se connecter</button>
            </form>
            </div>
            <p class="section__hint margin-top-1"><a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a></p>
            <p class="section__hint">Pas encore de compte ? <a href="{{ path('app_register') }}">Inscription</a></p>
        </div>
    </section>
</div>
{% endblock %}
