{% extends 'layout/street.html.twig' %}

{% block title %}{{ page.title }} | {{ site_brand.title }}{% endblock %}

{% block meta_description %}{{ 'press.meta_description'|trans }}{% endblock %}
{% block og_title %}{{ page.title }} | {{ site_brand.title }}{% endblock %}
{% block og_description %}{{ 'press.meta_description'|trans }}{% endblock %}
{% block og_image %}{{ absolute_url(asset('img/Social/og-home-preview.jpg')) }}{% endblock %}

{% block head %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": "{{ page.title }}",
        "description": "{{ 'press.meta_description'|trans }}",
        "mainEntity": {
            "@type": "Organization",
            "name": "{{ site_brand.title }}",
            "url": "{{ app.request.schemeAndHttpHost }}"
        }
    }
    </script>
    {% include '_partials/breadcrumb_jsonld.html.twig' with { items: [
        { name: 'nav.home'|trans, url: url('app_home') },
        { name: page.title, url: url('app_press') }
    ] } %}
{% endblock %}

{% block street_main %}
<div class="main main--wide">
    <section class="section section--press">
        <div class="section__inner">
            <h1 class="section__title section__title--tag">{{ page.title }}</h1>
            <p class="section__intro section__intro--muted">{{ page.intro }}</p>

            {% for categoryKey, category in categories %}
                <div class="press-category" id="press-{{ categoryKey }}">
                    <h2 class="press-category__title">
                        {% if categoryKey == 'video' %}
                            <span class="press-category__icon" aria-hidden="true">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                            </span>
                        {% elseif categoryKey == 'written' %}
                            <span class="press-category__icon" aria-hidden="true">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8M15 18h-5M10 6h8v4h-8z"/></svg>
                            </span>
                        {% else %}
                            <span class="press-category__icon" aria-hidden="true">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="22" x2="21" y2="22"/><line x1="6" y1="18" x2="6" y2="11"/><line x1="10" y1="18" x2="10" y2="11"/><line x1="14" y1="18" x2="14" y2="11"/><line x1="18" y1="18" x2="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>
                            </span>
                        {% endif %}
                        {{ category.title }}
                    </h2>

                    <div class="press-grid">
                        {% for item in category.items %}
                            <article class="press-card press-card--{{ categoryKey }}">
                                <div class="press-card__image">
                                    {% if item.image %}
                                        <img src="{{ asset(item.image) }}" alt="{{ item.title }}" loading="lazy" decoding="async" width="400" height="250">
                                    {% elseif item.url %}
                                        <div class="press-card__placeholder">
                                            <img src="https://www.google.com/s2/favicons?domain={{ item.url|split('/')[2] }}&sz=256" alt="" class="press-card__favicon" loading="lazy" width="4" height="4">
                                            <span class="press-card__placeholder-source">{{ item.source }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="press-card__body">
                                    <span class="press-card__source">{{ item.source }}</span>
                                    <h3 class="press-card__title">{{ item.title }}</h3>
                                    {% if item.url %}
                                        <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" class="press-card__link">
                                            {{ 'press.read_more'|trans }}
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                        </a>
                                    {% endif %}
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
