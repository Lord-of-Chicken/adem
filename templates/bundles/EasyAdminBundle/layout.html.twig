{% extends '@!EasyAdmin/layout.html.twig' %}

{% block head %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Permanent+Marker&family=Rubik:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    <style>
        :root{--banner-h:80px;--header-h:70px}
        .construction-banner{position:fixed;top:0;left:0;right:0;z-index:1001;background:#ffd700;padding:1.5rem 1rem 1.75rem;text-align:center;box-shadow:0 2px 10px rgba(0,0,0,.3)}
        .construction-banner__text{color:#000;font-weight:900;font-size:1.2rem;text-transform:uppercase;letter-spacing:2px}
        .site-header{position:fixed;top:var(--banner-h);left:0;right:0;z-index:999}
        body{padding-top:calc(var(--banner-h) + var(--header-h)) !important}
    </style>
{% endblock %}

{% block body %}
    <div class="construction-banner">
        <div class="construction-banner__text">🚧 SITE EN CHANTIER - TRAVAUX EN COURS 🚧</div>
    </div>
    {% include '_partials/street_header.html.twig' %}
    {{ parent() }}
    <script>
        (function(){
            function u(){
                var b=document.querySelector('.construction-banner'),h=document.querySelector('.site-header'),r=document.documentElement.style;
                if(b)r.setProperty('--banner-h',b.offsetHeight+'px');
                if(h)r.setProperty('--header-h',h.offsetHeight+'px');
            }
            document.addEventListener('DOMContentLoaded',u);
            window.addEventListener('load',u);
            window.addEventListener('resize',u);
            if(document.fonts&&document.fonts.ready)document.fonts.ready.then(u);
        })();
    </script>
{% endblock %}
