{% extends 'layout/street.html.twig' %}

{% block title %}Modifier mon profil | La Ruelle d'Adem{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    <section class="section">
        <div class="section__inner">
            <h1 class="section__title">Modifier mon profil</h1>
            
            <div class="card">
                {{ form_start(form) }}
                    <div class="form">
                        {{ form_row(form.firstName) }}
                        {{ form_row(form.lastName) }}
                        {{ form_row(form.address) }}
                        {{ form_row(form.email) }}
                        {{ form_row(form.newsletter) }}
                        
                        <div class="form-actions">
                            <button type="submit" class="btn btn--primary">Enregistrer</button>
                            <a href="{{ path('app_profile') }}" class="btn btn--secondary">Annuler</a>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </section>
</div>
{% endblock %}
