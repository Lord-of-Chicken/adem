{% extends 'layout/street.html.twig' %}

{% block title %}Mon Profil | La Ruelle d'Adem{% endblock %}

{% block street_main %}
<main class="main">
    <section class="section">
        <div class="section__inner">
            <h1 class="section__title">Mon Profil</h1>
            
            <div class="card">
                <h2 class="card__title">Informations personnelles</h2>
                <dl class="profile-info">
                    <dt>Prénom :</dt>
                    <dd>{{ app.user.firstName ?? '-' }}</dd>
                    
                    <dt>Nom :</dt>
                    <dd>{{ app.user.lastName ?? '-' }}</dd>
                    
                    <dt>Adresse :</dt>
                    <dd>{{ app.user.address ?? '-' }}</dd>
                    
                    <dt>E-mail :</dt>
                    <dd>{{ app.user.email }}</dd>
                </dl>
                
                <h3 class="card__title margin-top-2">Notifications</h3>
                <div class="profile-info">
                    <p>Statut newsletter : <strong>{{ app.user.newsletter ? 'Inscrit' : 'Non inscrit' }}</strong></p>
                    <form method="post" action="{{ path('app_profile_toggle_newsletter') }}" class="display-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_newsletter') }}">
                        <button type="submit" class="btn btn--primary margin-top-0-5">
                            {{ app.user.newsletter ? 'Se désinscrire de la newsletter' : 'S\'inscrire à la newsletter' }}
                        </button>
                    </form>
                </div>

                <h3 class="card__title margin-top-2">Actions</h3>
                <div class="profile-actions">
                    <a href="{{ path('app_profile_edit') }}" class="btn btn--primary">Modifier mon profil</a>
                    <a href="{{ path('app_profile_change_password') }}" class="btn btn--secondary">Changer mon mot de passe</a>
                </div>
                
                <div class="profile-actions">
                    <form method="post" action="{{ path('_logout_main') }}" class="display-inline">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="btn btn--secondary spray-magenta">Déconnexion</button>
                    </form>
                </div>
                
                <div class="profile-actions">
                    <form method="post" action="{{ path('app_profile_delete') }}" class="display-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre compte ? Cette action est irréversible et toutes vos données seront supprimées.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_profile') }}">
                        <button type="submit" class="btn btn--secondary delete-profile">Supprimer mon compte</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
