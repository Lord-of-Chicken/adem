{% extends 'layout/street.html.twig' %}

{% block title %}{{ page.title }} | {{ site_brand.title }}{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    <section class="section">
        <div class="section__inner">
            <h1 class="section__title">{{ page.title }}</h1>
            
            <div class="card">
                {{ form_start(form) }}
                    <div class="form">
                        {{ form_row(form.currentPassword) }}
                        {{ form_row(form.newPassword) }}
                        
                        <div class="form-actions">
                            <button type="submit" class="btn btn--primary">{{ page.submit }}</button>
                            <a href="{{ path('app_profile') }}" class="btn btn--secondary">{{ page.cancel }}</a>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </section>
</div>
{% endblock %}
