{% extends 'layout/street.html.twig' %}

{% block title %}Changer mon mot de passe | La Ruelle d'Adem{% endblock %}

{% block street_main %}
<main class="main">
    <section class="section">
        <div class="section__inner">
            <h1 class="section__title">Changer mon mot de passe</h1>
            
            <div class="card">
                {{ form_start(form) }}
                    <div class="form">
                        {{ form_row(form.currentPassword) }}
                        {{ form_row(form.newPassword) }}
                        
                        <div class="form-actions">
                            <button type="submit" class="btn btn--primary">Changer le mot de passe</button>
                            <a href="{{ path('app_profile') }}" class="btn btn--secondary">Annuler</a>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </section>
</main>
{% endblock %}
