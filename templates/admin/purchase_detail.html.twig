{% extends 'layout/admin.html.twig' %}

{% block admin_main %}
    <h1 class="admin-title">{{ 'admin.payment_detail_title'|trans }} #{{ paymentIntent.id }}</h1>
    <div class="admin-dashboard">
        <div class="admin-card">
            <h2 class="admin-card__title">{{ 'admin.general_info'|trans }}</h2>
            <dl class="admin-info">
                <div class="admin-info-row">
                    <span class="admin-info-label">{{ 'admin.id'|trans }}:</span>
                    <span class="admin-info-value">{{ paymentIntent.id }}</span>
                </div>
                <div class="admin-info-row">
                    <span class="admin-info-label">{{ 'admin.status'|trans }}:</span>
                    <span class="admin-info-value">
                        <span class="admin-badge admin-badge--{{ paymentIntent.status }}">{{ paymentIntent.status }}</span>
                    </span>
                </div>
                <div class="admin-info-row">
                    <span class="admin-info-label">{{ 'admin.amount'|trans }}:</span>
                    <span class="admin-info-value">{{ (paymentIntent.amount / 100)|number_format(2, ',', ' ') }} {{ paymentIntent.currency|upper }}</span>
                </div>
                <div class="admin-info-row">
                    <span class="admin-info-label">{{ 'admin.date'|trans }}:</span>
                    <span class="admin-info-value">{{ paymentIntent.created|date('d/m/Y H:i') }}</span>
                </div>
                <div class="admin-info-row">
                    <span class="admin-info-label">{{ 'admin.description'|trans }}:</span>
                    <span class="admin-info-value">{{ paymentIntent.description ?? '-' }}</span>
                </div>
            </dl>
        </div>

        {% if paymentIntent.customer_email %}
        <div class="admin-card">
            <h2 class="admin-card__title">{{ 'admin.client'|trans }}</h2>
            <dl class="admin-info">
                <div class="admin-info-row">
                    <span class="admin-info-label">{{ 'admin.email'|trans }}:</span>
                    <span class="admin-info-value">{{ paymentIntent.customer_email }}</span>
                </div>
                {% if paymentIntent.metadata.user_id is defined %}
                <div class="admin-info-row">
                    <span class="admin-info-label">{{ 'admin.id'|trans }} {{ 'admin.users'|trans }}:</span>
                    <span class="admin-info-value">{{ paymentIntent.metadata.user_id }}</span>
                </div>
                {% endif %}
            </dl>
        </div>
        {% endif %}

        {% if paymentIntent.metadata %}
        <div class="admin-card">
            <h2 class="admin-card__title">{{ 'admin.metadata'|trans }}</h2>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>{{ 'admin.key'|trans }}</th>
                        <th>{{ 'admin.value'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for key, value in paymentIntent.metadata %}
                    <tr>
                        <td>{{ key }}</td>
                        <td>{{ value }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p class="admin-empty">{{ 'admin.no_metadata'|trans }}</p>
        {% endif %}
    </div>
    <div class="admin-actions">
        <a href="{{ path('app_admin_purchases') }}" class="admin-btn admin-btn--secondary">{{ 'admin.back_to_list'|trans }}</a>
    </div>
{% endblock %}
