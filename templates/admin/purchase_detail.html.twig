{% extends 'layout/admin.html.twig' %}

{% block admin_content %}
    <h1 class="admin-title">Détail du Paiement #{{ paymentIntent.id }}</h1>
    
    <div class="admin-card">
        <div class="admin-card__header">
            <h2 class="admin-card__title">Informations Générales</h2>
        </div>
        <div class="admin-card__body">
            <div class="admin-info-grid">
                <div class="admin-info-item">
                    <span class="admin-info-label">ID:</span>
                    <span class="admin-info-value">{{ paymentIntent.id }}</span>
                </div>
                <div class="admin-info-item">
                    <span class="admin-info-label">Statut:</span>
                    <span class="admin-badge admin-badge--{{ paymentIntent.status }}">
                        {% if paymentIntent.status == 'succeeded' %}Payé
                        {% elseif paymentIntent.status == 'processing' %}En cours
                        {% elseif paymentIntent.status == 'canceled' %}Annulé
                        {% else %}{{ paymentIntent.status|capitalize }}
                        {% endif %}
                    </span>
                </div>
                <div class="admin-info-item">
                    <span class="admin-info-label">Montant:</span>
                    <span class="admin-info-value">{{ (paymentIntent.amount / 100)|number_format(2, ',', ' ') }} {{ paymentIntent.currency|upper }}</span>
                </div>
                <div class="admin-info-item">
                    <span class="admin-info-label">Date de création:</span>
                    <span class="admin-info-value">{{ paymentIntent.created|date('d/m/Y H:i') }}</span>
                </div>
                <div class="admin-info-item">
                    <span class="admin-info-label">Description:</span>
                    <span class="admin-info-value">{{ paymentIntent.description ?: '-' }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-card">
        <div class="admin-card__header">
            <h2 class="admin-card__title">Client</h2>
        </div>
        <div class="admin-card__body">
            <div class="admin-info-grid">
                <div class="admin-info-item">
                    <span class="admin-info-label">Email:</span>
                    <span class="admin-info-value">{{ paymentIntent.receipt_email ?? (paymentIntent.metadata.user_email is defined ? paymentIntent.metadata.user_email : '-') }}</span>
                </div>
                {% if paymentIntent.metadata.user_id is defined %}
                <div class="admin-info-item">
                    <span class="admin-info-label">ID Utilisateur:</span>
                    <span class="admin-info-value">{{ paymentIntent.metadata.user_id }}</span>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="admin-card">
        <div class="admin-card__header">
            <h2 class="admin-card__title">Métadonnées</h2>
        </div>
        <div class="admin-card__body">
            {% if paymentIntent.metadata is not empty %}
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Clé</th>
                            <th>Valeur</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for key, value in paymentIntent.metadata %}
                        <tr>
                            <td>{{ key }}</td>
                            <td>{{ value }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p class="admin-empty">Aucune métadonnée disponible</p>
            {% endif %}
        </div>
    </div>

    <div class="admin-actions">
        <a href="{{ path('app_admin_purchases') }}" class="admin-btn admin-btn--secondary">Retour à la liste</a>
    </div>
{% endblock %}
