{% extends 'layout/admin.html.twig' %}

{% block admin_main %}
    <h1 class="admin-title">{{ 'admin.purchases_title'|trans }}</h1>
    <div class="admin-toolbar">
        <div class="admin-filters">
            <label for="status-filter">{{ 'admin.status'|trans }} :</label>
            <select id="status-filter">
                <option value="">{{ 'admin.status_all'|trans }}</option>
                <option value="paid">{{ 'admin.status_paid'|trans }}</option>
                <option value="pending">{{ 'admin.status_pending'|trans }}</option>
                <option value="cancelled">{{ 'admin.status_cancelled'|trans }}</option>
                <option value="refunded">{{ 'admin.status_refunded'|trans }}</option>
            </select>
            <label for="currency-filter">{{ 'admin.currency'|trans }} :</label>
            <select id="currency-filter">
                <option value="EUR">EUR</option>
                <option value="CHF">CHF</option>
                <option value="USD">USD</option>
            </select>
        </div>
    </div>
    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>{{ 'admin.id'|trans }}</th>
                    <th>{{ 'admin.email'|trans }}</th>
                    <th>{{ 'admin.amount'|trans }} <span id="currency-symbol">€</span></th>
                    <th>{{ 'admin.date'|trans }}</th>
                    <th>{{ 'admin.status'|trans }}</th>
                    <th>{{ 'admin.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for paymentIntent in payment_intents %}
                    <tr>
                        <td>{{ paymentIntent.id|slice(0, 12) }}...</td>
                        <td>{{ paymentIntent.customer_email ?? '-' }}</td>
                        <td>{{ (paymentIntent.amount / 100)|number_format(2, ',', ' ') }}</td>
                        <td>{{ paymentIntent.created|date('d/m/Y H:i') }}</td>
                        <td>
                            <span class="admin-badge admin-badge--{{ paymentIntent.status }}">{{ paymentIntent.status }}</span>
                        </td>
                        <td>
                            <a href="{{ path('app_admin_purchase_detail', {id: paymentIntent.id}) }}" class="admin-btn admin-btn--small">{{ 'admin.details'|trans }}</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="admin-empty">{{ 'admin.no_payment'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ importmap('admin-purchases') }}
{% endblock %}
