{% extends 'layout/admin.html.twig' %}

{% block admin_main %}
    <h1 class="admin-title">{{ 'admin.users_title'|trans }}</h1>
    
    <div class="admin-toolbar">
        <div class="admin-filters">
            <label for="newsletter-filter" class="admin-filter__label">{{ 'admin.newsletter_filter'|trans }}</label>
            <select id="newsletter-filter" class="admin-filter__select" data-controller="nav-select" data-nav-select-mode-value="query" data-nav-select-param-value="newsletter" data-action="change->nav-select#navigate">
                <option value="">{{ 'admin.filter_all'|trans }}</option>
                <option value="subscribed" {{ newsletter_filter == 'subscribed' ? 'selected' : '' }}>{{ 'admin.filter_subscribed'|trans }}</option>
                <option value="not_subscribed" {{ newsletter_filter == 'not_subscribed' ? 'selected' : '' }}>{{ 'admin.filter_not_subscribed'|trans }}</option>
            </select>
        </div>
    </div>
    
    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>{{ 'admin.id'|trans }}</th>
                    <th>{{ 'admin.email'|trans }}</th>
                    <th>{{ 'admin.name'|trans }}</th>
                    <th>{{ 'admin.newsletter'|trans }}</th>
                    <th>{{ 'admin.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.id }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.firstName ?? '' }} {{ user.lastName ?? '' }}</td>
                        <td>
                            {% if user.newsletter %}
                                <span class="admin-badge admin-badge--success">{{ 'admin.yes'|trans }}</span>
                            {% else %}
                                <span class="admin-badge admin-badge--danger">{{ 'admin.no'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="#" class="admin-btn admin-btn--small">{{ 'admin.view'|trans }}</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="admin-empty">{{ 'admin.no_user_found'|trans }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if pagination.last_page > 1 %}
        <nav class="admin-pagination" aria-label="{{ 'admin.pagination'|trans }}">
            {% if pagination.page > 1 %}
                <a class="admin-btn admin-btn--small" href="{{ path('app_admin_users', { newsletter: newsletter_filter, page: pagination.page - 1 }) }}">{{ 'admin.previous'|trans }}</a>
            {% endif %}
            <span class="admin-pagination__status">{{ pagination.page }} / {{ pagination.last_page }}</span>
            {% if pagination.page < pagination.last_page %}
                <a class="admin-btn admin-btn--small" href="{{ path('app_admin_users', { newsletter: newsletter_filter, page: pagination.page + 1 }) }}">{{ 'admin.next'|trans }}</a>
            {% endif %}
        </nav>
    {% endif %}
{% endblock %}
