{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.admin'|trans }} | {{ site_brand.title }}{% endblock %}

{% block body_class %}page-admin{% endblock %}

{% block top_bars %}{% endblock %}

{% block body %}
    <style>
        body.page-admin {
            padding-top: 0 !important;
        }
        .admin-layout {
            display: flex;
            min-height: 100vh;
            padding-top: 0 !important;
        }
        .admin-sidebar {
            width: 250px;
            background: var(--concrete-light);
            border-right: 2px solid var(--spray-cyan);
            padding: 1.5rem;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            overflow-y: auto;
        }
        .admin-sidebar__header {
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--spray-magenta);
        }
        .admin-sidebar__title {
            margin: 0;
            font-family: var(--font-display);
            font-size: 1.5rem;
            color: var(--paper);
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .admin-nav {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .admin-nav__link {
            display: block;
            padding: 0.75rem 1rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--paper);
            text-decoration: none;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 1px;
            transition: all 0.15s ease;
        }
        .admin-nav__link:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.2);
        }
        .admin-nav__link--active {
            background: var(--spray-magenta);
            border-color: var(--spray-magenta);
            color: var(--paper);
        }
        .admin-main {
            flex: 1;
            margin-left: 250px;
            padding: 2rem;
        }
        .admin-title {
            font-family: var(--font-display);
            font-size: 2.5rem;
            color: var(--paper);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 2rem;
        }
        .admin-dashboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
        }
        .admin-card {
            background: var(--concrete-light);
            border: 2px solid var(--spray-cyan);
            padding: 2rem;
            border-radius: 0.5rem;
        }
        .admin-card__title {
            font-family: var(--font-display);
            font-size: 1.5rem;
            color: var(--paper);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 1rem;
        }
        .admin-card__text {
            color: var(--paper);
            line-height: 1.6;
        }
    </style>
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-sidebar__header">
                <h2 class="admin-sidebar__title">{{ page.sidebar_title }}</h2>
            </div>
            <nav class="admin-nav">
                <a href="{{ path('app_admin') }}" class="admin-nav__link {{ app.request.attributes.get('_route') == 'app_admin' ? 'admin-nav__link--active' : '' }}">
                    {{ page.nav_dashboard }}
                </a>
                <a href="{{ path('app_admin_carousel') }}" class="admin-nav__link {{ app.request.attributes.get('_route') == 'app_admin_carousel' ? 'admin-nav__link--active' : '' }}">
                    {{ page.nav_carousel }}
                </a>
                <a href="{{ path('app_admin_users') }}" class="admin-nav__link {{ app.request.attributes.get('_route') == 'app_admin_users' ? 'admin-nav__link--active' : '' }}">
                    {{ page.nav_users }}
                </a>
                <a href="{{ path('app_admin_purchases') }}" class="admin-nav__link {{ app.request.attributes.get('_route') == 'app_admin_purchases' ? 'admin-nav__link--active' : '' }}">
                    {{ page.nav_stripe }}
                </a>
            </nav>
        </aside>
        <main class="admin-main">
            {% block admin_main %}
                <h1 class="admin-title">{{ page.dashboard_title }}</h1>
                <div class="admin-dashboard">
                    <div class="admin-card">
                        <h2 class="admin-card__title">{{ page.welcome_title }}</h2>
                        <p class="admin-card__text">{{ page.welcome_text }}</p>
                    </div>
                </div>
            {% endblock %}
        </main>
    </div>
{% endblock %}
