{% extends 'layout/admin.html.twig' %}

{% block admin_content %}
    <h1 class="admin-title">Gestion du Carousel</h1>
    
    <div class="admin-toolbar">
        <a href="{{ path('app_admin_carousel_add') }}" class="btn btn--primary">{{ 'admin.add_image'|trans }}</a>
    </div>
    
    <div class="admin-table-container">
        <table class="admin-table" data-controller="sortable-carousel" data-sortable-carousel-update-url-value="{{ path('app_admin_carousel_reorder') }}" data-sortable-carousel-csrf-token-value="{{ csrf_token('carousel_reorder') }}">
            <thead>
                <tr>
                    <th></th>
                    <th>Image</th>
                    <th>Titre</th>
                    <th>Chemin</th>
                    <th>Publié</th>
                    <th>Ordre</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for media_item in media_items %}
                    <tr data-id="{{ media_item.id }}">
                        <td class="drag-handle" aria-label="{{ 'admin.drag_to_reorder'|trans }}">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="8" x2="21" y2="8"/><line x1="3" y1="16" x2="21" y2="16"/></svg>
                        </td>
                        <td>
                            {% if media_item.assetPath %}
                                <img src="{{ asset(media_item.assetPath) }}" alt="{{ media_item.alt|default('') }}" class="admin-thumbnail" loading="lazy" decoding="async" width="100" height="100">
                            {% else %}
                                <span class="admin-table__placeholder">-</span>
                            {% endif %}
                        </td>
                        <td>{{ media_item.title }}</td>
                        <td><code>{{ media_item.assetPath }}</code></td>
                        <td>
                            {% if media_item.published %}
                                <span class="admin-badge admin-badge--success">Oui</span>
                            {% else %}
                                <span class="admin-badge admin-badge--danger">Non</span>
                            {% endif %}
                        </td>
                        <td>{{ media_item.sortOrder }}</td>
                        <td>
                            <div class="admin-table__actions">
                                <a href="{{ path('app_admin_carousel_edit', { id: media_item.id }) }}" class="btn btn--secondary">{{ 'admin.edit'|trans }}</a>
                                <form method="post" action="{{ path('app_admin_carousel_delete', { id: media_item.id }) }}" data-confirm-title="{{ 'admin.delete'|trans }}" data-confirm-message="{{ 'admin.carousel_delete_confirm'|trans }}" data-confirm-confirm-label="{{ 'admin.delete'|trans }}" data-confirm-cancel-label="{{ 'admin.cancel'|trans }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('carousel_delete_' ~ media_item.id) }}">
                                    <button type="submit" class="btn btn--danger">{{ 'admin.delete'|trans }}</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="admin-empty">Aucune image dans le carousel.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
