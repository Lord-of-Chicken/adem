{% extends 'layout/street.html.twig' %}

{% block title %}{{ 'nav.about'|trans }} | {{ site_brand.title }}{% endblock %}

{% block meta_description %}{{ 'about.meta_description'|trans }}{% endblock %}

{% block head %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "AboutPage",
        "name": "{{ 'nav.about'|trans }}",
        "description": "{{ 'about.meta_description'|trans }}",
        "mainEntity": {
            "@type": "Organization",
            "name": "{{ site_brand.title }}",
            "description": "{{ 'home.subtitle'|trans }}",
            "url": "{{ app.request.schemeAndHttpHost }}"
        }
    }
    </script>
{% endblock %}

{% block street_main %}
<div class="main main--narrow">
    <section class="section section--auth">
        <div class="section__inner section__inner--narrow">
            <h1 class="section__title section__title--tag">{{ page.title }}</h1>

            <div class="card">
                <h2 class="card__title">{{ 'about.project_title'|trans }}</h2>
                <p class="section__intro">{{ 'about.project_description'|trans }}</p>

                <h2 class="card__title">{{ 'about.mission_title'|trans }}</h2>
                <p class="section__intro">{{ 'about.mission_description'|trans }}</p>

                <h2 class="card__title">{{ 'about.transparency_title'|trans }}</h2>
                <p class="section__intro">{{ 'about.transparency_description'|trans }}</p>

                <h2 class="card__title">{{ 'about.contact_title'|trans }}</h2>
                <p class="section__intro">{{ 'about.contact_description'|trans }}</p>
            </div>
        </div>
    </section>
</div>
{% endblock %}
