{% extends 'layout/street.html.twig' %}

{% block title %}Flower Power Crowdfunding | {{ site_brand.title }}{% endblock %}

{% block street_main %}
<main class="main" data-controller="street-tilt">
    <section class="hero hero--spray" aria-labelledby="hero-title">
        <div class="hero__content hero__content--pop">
            <p class="hero__eyebrow">{{ hero.eyebrow }}</p>
            <h1 id="hero-title" class="hero__title">
                <span class="hero__title-line hero__title-line--1">{{ hero.title }}</span>
            </h1>
            <p class="hero__lead">{{ hero.lead }}</p>
        </div>
    </section>

    <section class="section section--reveal" id="{{ sections.medias.id }}" style="--reveal: 2" aria-labelledby="medias-title">
        <div class="section__inner">
            <h2 id="medias-title" class="section__title section__title--tag">{{ sections.medias.title }}</h2>
            <p class="section__intro">{{ sections.medias.intro }}</p>
            {% if media_items is not empty %}
                <div class="media-slider">
                    <div class="media-slider__track">
                        {% for media in media_items %}
                            <div class="media-slider__slide">
                                <img
                                    src="{{ asset(media.assetPath) }}"
                                    alt="{{ media.alt|default('La Ruelle dAdem') }}"
                                    loading="lazy"
                                    decoding="async"
                                    width="800"
                                    height="600"
                                >
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <p class="section__hint">Les photos seront visibles après <code>php bin/console app:seed-ruelle</code> (base alimentée depuis <code>assets/img/ruelle</code>).</p>
            {% endif %}
        </div>
    </section>

    <section class="section section--reveal" id="{{ sections.offres.id }}" style="--reveal: 3" aria-labelledby="offres-title">
        <div class="section__inner">
            <h2 id="offres-title" class="section__title section__title--tag">{{ sections.offres.title }}</h2>
            <p class="section__intro">{{ sections.offres.intro }}</p>
            {% if not is_granted('ROLE_USER') %}
                <p class="section__hint"><a href="{{ path('app_login') }}">Connecte-toi</a> ou <a href="{{ path('app_register') }}">crée un compte</a> pour ajouter des participations au panier.</p>
            {% endif %}

            <div class="grid grid--tiers">
                {% for tier in tiers_standard %}
                    <article
                        class="card card--tier card--sticker"
                        data-street-tilt-target="tilt"
                        style="--i: {{ loop.index0 }}"
                    >
                        <h3 class="card__title">{{ tier.title }}</h3>
                        <p class="card__price">
                            {{ tier.price }}&nbsp;{{ tier.price_unit }}
                            {% if tier.price_suffix is not null %}
                                <span class="card__unit">{{ tier.price_suffix }}</span>
                            {% endif %}
                        </p>
                        <p class="card__detail">{{ tier.detail }}</p>
                        {% if tier.priced_per_unit %}
                            <div class="card__cart-controls">
                                <div class="qty-controls qty-controls--compact">
                                    <button type="button" 
                                            class="qty-btn qty-btn--minus qty-btn--small" 
                                            data-tier-id="{{ tier.id }}"
                                            data-min-qty="{{ tier.min_qty }}"
                                            aria-label="Diminuer la quantité">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M5 12h14"/>
                                        </svg>
                                    </button>
                                    
                                    <div class="qty-display qty-display--compact">
                                        <span class="qty-number" data-tier-id="{{ tier.id }}">{{ tier.min_qty }}</span>
                                        <span class="qty-label">pièce{% if tier.min_qty > 1 %}s{% endif %}</span>
                                    </div>
                                    
                                    <button type="button" 
                                            class="qty-btn qty-btn--plus qty-btn--small" 
                                            data-tier-id="{{ tier.id }}"
                                            data-max-qty="{{ tier.max_qty }}"
                                            aria-label="Augmenter la quantité">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 5v14M5 12h14"/>
                                        </svg>
                                    </button>
                                </div>
                                
                                <!-- Champ caché pour le JavaScript -->
                                <input type="hidden" id="hidden-qty-{{ tier.id }}" value="{{ tier.min_qty }}">
                                
                                {% if is_granted('ROLE_USER') %}
                                    <button type="button" class="btn btn--primary btn--small" onclick="addToCart('{{ tier.id }}')">
                                        Ajouter
                                    </button>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="card__cart-controls">
                                <div class="qty-controls qty-controls--compact">
                                    <button type="button" 
                                            class="qty-btn qty-btn--minus qty-btn--small" 
                                            data-tier-id="{{ tier.id }}"
                                            data-min-qty="{{ tier.min_qty }}"
                                            aria-label="Diminuer la quantité">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M5 12h14"/>
                                        </svg>
                                    </button>
                                    
                                    <div class="qty-display qty-display--compact">
                                        <span class="qty-number" data-tier-id="{{ tier.id }}">1</span>
                                        <span class="qty-label">pièce</span>
                                    </div>
                                    
                                    <button type="button" 
                                            class="qty-btn qty-btn--plus qty-btn--small" 
                                            data-tier-id="{{ tier.id }}"
                                            data-max-qty="{{ tier.max_qty }}"
                                            aria-label="Augmenter la quantité">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M12 5v14M5 12h14"/>
                                        </svg>
                                    </button>
                                </div>
                                
                                <!-- Champ caché pour le JavaScript -->
                                <input type="hidden" id="hidden-qty-{{ tier.id }}" value="1">
                                
                                {% if is_granted('ROLE_USER') %}
                                    <button type="button" class="btn btn--primary btn--small" onclick="addToCart('{{ tier.id }}')">
                                        Ajouter
                                    </button>
                                {% endif %}
                            </div>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="section section--vip section--reveal" id="{{ sections.vip.id }}" style="--reveal: 2" aria-labelledby="vip-title">
        <div class="section__inner">
            <h2 id="vip-title" class="section__title section__title--tag section__title--vip">{{ sections.vip.title }}</h2>
            <p class="section__subtitle">{{ sections.vip.subtitle }}</p>

            <div class="grid grid--tiers">
                {% for tier in tiers_vip %}
                    <article
                        class="card card--tier card--featured card--sticker card--sticker--hot"
                        data-street-tilt-target="tilt"
                        style="--i: {{ loop.index0 }}"
                    >
                        <h3 class="card__title">{{ tier.title }}</h3>
                        <p class="card__price">{{ tier.price }}&nbsp;{{ tier.price_unit }}</p>
                        <p class="card__detail">{{ tier.detail }}</p>
                        <div class="card__cart-controls">
                            <div class="qty-controls qty-controls--compact">
                                <button type="button" 
                                        class="qty-btn qty-btn--minus qty-btn--small" 
                                        data-tier-id="{{ tier.id }}"
                                        data-min-qty="{{ tier.min_qty }}"
                                        aria-label="Diminuer la quantité">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M5 12h14"/>
                                    </svg>
                                </button>
                                
                                <div class="qty-display qty-display--compact">
                                    <span class="qty-number" data-tier-id="{{ tier.id }}">1</span>
                                    <span class="qty-label">pièce</span>
                                </div>
                                
                                <button type="button" 
                                        class="qty-btn qty-btn--plus qty-btn--small" 
                                        data-tier-id="{{ tier.id }}"
                                        data-max-qty="{{ tier.max_qty }}"
                                        aria-label="Augmenter la quantité">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 5v14M5 12h14"/>
                                    </svg>
                                </button>
                            </div>
                            
                            <!-- Champ caché pour le JavaScript -->
                            <input type="hidden" id="hidden-qty-{{ tier.id }}" value="1">
                            
                            {% if is_granted('ROLE_USER') %}
                                    <label class="form__label" for="donor-{{ tier.id }}">
                                        Nom affiché 
                                        {% if tier.donor_field %}<span class="form__required">*</span>{% else %}<span class="form__hint">(optionnel)</span>{% endif %}
                                    </label>
                                    <input class="form__input" type="text" id="donor-{{ tier.id }}" name="donor_name" autocomplete="name" placeholder="Prénom Nom" {% if tier.donor_field %}value="Anonyme"{% endif %}>
                                    <button type="button" class="btn btn--primary btn--small" onclick="addToCart('{{ tier.id }}')">
                                        Ajouter
                                    </button>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="section section--reveal" id="{{ sections.don_libre.id }}" style="--reveal: 3" aria-labelledby="don-libre-title">
        <div class="section__inner">
            <h2 id="don-libre-title" class="section__title section__title--tag">{{ sections.don_libre.title }}</h2>
            <p class="section__intro">{{ sections.don_libre.intro }}</p>

            <div class="grid grid--tiers">
                <article
                    class="card card--tier card--sticker"
                    data-street-tilt-target="tilt"
                    style="--i: 0"
                >
                    <h3 class="card__title">Don Libre</h3>
                    <p class="card__price">Montant libre</p>
                    <p class="card__detail">Soutiens le projet avec le montant de ton choix</p>
                    {% if is_granted('ROLE_USER') %}
                        <form class="form" method="post" action="{{ path('app_cart_add') }}" aria-label="Don libre">
                            <input type="hidden" name="_token" value="{{ csrf_token('cart_add') }}">
                            <input type="hidden" name="tier_id" value="free_donation">
                            <input type="hidden" name="quantity" value="1">
                            <label class="form__label" for="free-amount">Montant (e)</label>
                            <input type="number" id="free-amount" name="amount" class="form__input form__input--amount" min="1" step="0.01" placeholder="Ex. 15" required>
                            <label class="form__label" for="free-donor-name">Nom du donateur <span class="form__hint">(facultatif)</span></label>
                            <input type="text" id="free-donor-name" name="donor_name" class="form__input" autocomplete="name" placeholder="Laisser vide pour rester anonyme">
                            <p class="form__note">Le montant indiqué sera ajouté à votre panier.</p>
                            <button type="submit" class="btn btn--primary btn--small">Ajouter au panier</button>
                        </form>
                    {% else %}
                        <div class="form">
                            <label class="form__label" for="free-amount">Montant (e)</label>
                            <input type="number" id="free-amount" name="amount" class="form__input form__input--amount" min="1" step="0.01" placeholder="Ex. 15" disabled>
                            <label class="form__label" for="free-donor-name">Nom du donateur <span class="form__hint">(facultatif)</span></label>
                            <input type="text" id="free-donor-name" name="donor_name" class="form__input" autocomplete="name" placeholder="Laisser vide pour rester anonyme" disabled>
                            <p class="form__note">Connectez-vous pour pouvoir faire un don.</p>
                            <a href="{{ path('app_login') }}" class="btn btn--primary btn--small">Connectez-vous</a>
                        </div>
                    {% endif %}
                </article>
            </div>
        </div>
    </section>

    <section class="section section--contact section--reveal" id="{{ sections.contact.id }}" style="--reveal: 4" aria-labelledby="contact-title">
        <div class="section__inner section__inner--narrow">
            <h2 id="contact-title" class="section__title section__title--tag">{{ sections.contact.title }}</h2>
            <p class="section__intro">{{ sections.contact.intro }}</p>
            <form class="form form--stack" action="#" method="post" aria-label="Formulaire de contact">
                <label class="form__label" for="proposal">Ma proposition</label>
                <textarea id="proposal" name="proposal" class="form__textarea" rows="5" required placeholder="Décris ton idée, ton offre de partenariat ou ta suggestion…"></textarea>
                <div class="form__row">
                    <div class="form__field">
                        <label class="form__label" for="lastname">Nom</label>
                        <input type="text" id="lastname" name="lastname" class="form__input" autocomplete="family-name">
                    </div>
                    <div class="form__field">
                        <label class="form__label" for="firstname">Prénom</label>
                        <input type="text" id="firstname" name="firstname" class="form__input" autocomplete="given-name">
                    </div>
                </div>
                <label class="form__label" for="org">Association, société</label>
                <input type="text" id="org" name="organization" class="form__input" autocomplete="organization">
                <label class="form__label" for="email">Mail</label>
                <input type="email" id="email" name="email" class="form__input" autocomplete="email" required>
                <button type="submit" class="btn btn--primary">Envoyer</button>
            </form>
        </div>
    </section>

    <section class="section section--newsletter section--reveal" id="{{ sections.newsletter.id }}" style="--reveal: 5" aria-labelledby="newsletter-title">
        <div class="section__inner section__inner--narrow">
            <h2 id="newsletter-title" class="section__title section__title--tag">{{ sections.newsletter.title }}</h2>
            <p class="section__intro">{{ sections.newsletter.intro }}</p>
            <form class="form form--inline form--newsletter" action="#" method="post" aria-label="Inscription mailing list">
                <label class="visually-hidden" for="newsletter-email">Adresse e-mail</label>
                <input type="email" id="newsletter-email" name="newsletter_email" class="form__input" autocomplete="email" required placeholder="ton@email.fr">
                <button type="submit" class="btn btn--secondary">S’inscrire</button>
            </form>
        </div>
    </section>

    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Script simple pour les boutons + et -
        document.querySelectorAll('.qty-btn--plus').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const tierId = this.dataset.tierId;
                const maxQty = parseInt(this.dataset.maxQty);
                const hiddenInput = document.getElementById(`hidden-qty-${tierId}`);
                const numberDisplay = document.querySelector(`[data-tier-id="${tierId}"].qty-number`);
                const labelDisplay = numberDisplay?.nextElementSibling;
                
                // Vérifier si les éléments existent
                if (!hiddenInput || !numberDisplay) {
                    console.warn('Éléments manquants pour tierId:', tierId);
                    return;
                }
                
                let currentQty = parseInt(hiddenInput.value) || 1;
                const newQty = Math.min(currentQty + 1, maxQty);
                
                hiddenInput.value = newQty;
                numberDisplay.textContent = newQty;
                if (labelDisplay) {
                    labelDisplay.textContent = `pièce${newQty > 1 ? 's' : ''}`;
                }
                
                // Synchroniser le champ quantity du formulaire s'il existe
                const formQtyInput = document.getElementById(`form-qty-${tierId}`);
                if (formQtyInput) {
                    formQtyInput.value = newQty;
                }
                
                // Mettre à jour l'état des boutons
                const minusBtn = document.querySelector(`[data-tier-id="${tierId}"].qty-btn--minus`);
                if (minusBtn) {
                    minusBtn.disabled = newQty <= 1;
                }
                this.disabled = newQty >= maxQty;
            });
        });
        
        document.querySelectorAll('.qty-btn--minus').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const tierId = this.dataset.tierId;
                const minQty = parseInt(this.dataset.minQty);
                const hiddenInput = document.getElementById(`hidden-qty-${tierId}`);
                const numberDisplay = document.querySelector(`[data-tier-id="${tierId}"].qty-number`);
                const labelDisplay = numberDisplay?.nextElementSibling;
                
                // Vérifier si les éléments existent
                if (!hiddenInput || !numberDisplay) {
                    console.warn('Éléments manquants pour tierId:', tierId);
                    return;
                }
                
                let currentQty = parseInt(hiddenInput.value) || 1;
                const newQty = Math.max(currentQty - 1, minQty);
                
                hiddenInput.value = newQty;
                numberDisplay.textContent = newQty;
                if (labelDisplay) {
                    labelDisplay.textContent = `pièce${newQty > 1 ? 's' : ''}`;
                }
                
                // Synchroniser le champ quantity du formulaire s'il existe
                const formQtyInput = document.getElementById(`form-qty-${tierId}`);
                if (formQtyInput) {
                    formQtyInput.value = newQty;
                }
                
                // Mettre à jour l'état des boutons
                const plusBtn = document.querySelector(`[data-tier-id="${tierId}"].qty-btn--plus`);
                if (plusBtn) {
                    plusBtn.disabled = newQty >= parseInt(plusBtn.dataset.maxQty);
                }
                this.disabled = newQty <= minQty;
            });
        });
    });
    
    // Fonction pour ajouter un produit au panier via AJAX
    function addToCart(tierId) {
        const hiddenInput = document.getElementById(`hidden-qty-${tierId}`);
        const donorInput = document.getElementById(`donor-${tierId}`);
        
        if (!hiddenInput) {
            console.error('Champ quantité non trouvé pour', tierId);
            return;
        }
        
        const quantity = hiddenInput.value;
        const donorName = donorInput ? donorInput.value : null;
        
        // Créer les données du formulaire
        const formData = new FormData();
        
        // Récupérer le token CSRF depuis le premier formulaire disponible
        const csrfToken = document.querySelector('input[name="_token"]')?.value || '';
        formData.append('_token', csrfToken);
        formData.append('tier_id', tierId);
        formData.append('quantity', quantity);
        if (donorName) {
            formData.append('donor_name', donorName);
        }
        
        // Envoyer la requête AJAX
        fetch('/panier/ajouter', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Mettre à jour le badge du panier si nécessaire
                updateCartBadge(data.cartCount);
                
                // Afficher un message de succès
                showFlashMessage('success', 'Participation ajoutée au panier.');
                
                // Réinitialiser la quantité pour ce produit
                resetQuantity(tierId);
            } else {
                showFlashMessage('danger', data.message || 'Erreur lors de l\'ajout au panier.');
            }
        })
        .catch(error => {
            console.error('Erreur:', error);
            showFlashMessage('danger', 'Erreur lors de l\'ajout au panier.');
        });
    }
    
    // Fonction pour réinitialiser la quantité d'un produit
    function resetQuantity(tierId) {
        const hiddenInput = document.getElementById(`hidden-qty-${tierId}`);
        const numberDisplay = document.querySelector(`[data-tier-id="${tierId}"].qty-number`);
        const labelDisplay = numberDisplay?.nextElementSibling;
        
        if (hiddenInput && numberDisplay) {
            const minQty = parseInt(numberDisplay.textContent) || 1;
            hiddenInput.value = minQty;
            numberDisplay.textContent = minQty;
            if (labelDisplay) {
                labelDisplay.textContent = `pièce${minQty > 1 ? 's' : ''}`;
            }
        }
    }
    
    // Fonction pour mettre à jour le badge du panier
    function updateCartBadge(count) {
        const cartBadge = document.querySelector('.site-header__cart-badge');
        if (cartBadge) {
            if (count > 0) {
                cartBadge.textContent = count;
                cartBadge.style.display = 'inline';
            } else {
                cartBadge.style.display = 'none';
            }
        }
    }
    
    // Fonction pour afficher un message flash
    function showFlashMessage(type, message) {
        // Créer l'élément de message
        const flashDiv = document.createElement('div');
        flashDiv.className = `flash flash--${type}`;
        flashDiv.textContent = message;
        flashDiv.setAttribute('role', 'status');
        
        // Ajouter au début du body
        document.body.insertBefore(flashDiv, document.body.firstChild);
        
        // Supprimer après 3 secondes
        setTimeout(() => {
            flashDiv.remove();
        }, 3000);
    }
    </script>
{% endblock %}
