{% extends 'layout/street.html.twig' %}

{% block title %}{{ 'home.title'|trans }} | {{ site_brand.title }}{% endblock %}

{% block meta_description %}{{ 'home.meta_description'|trans }}{% endblock %}
{% block og_description %}{{ 'home.og_description'|trans }}{% endblock %}
{% block og_image %}{{ absolute_url(asset('img/Social/og-home-preview.jpg')) }}{% endblock %}

{% block og_title %}Fais une fleur à Adem | {{ site_brand.title }}{% endblock %}

{% block head %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "{{ site_brand.title }}",
        "url": "{{ app.request.schemeAndHttpHost }}",
        "description": "{{ 'home.subtitle'|trans }}",
        "inLanguage": "{{ app.request.locale }}"
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "{{ site_brand.title }}",
        "url": "{{ app.request.schemeAndHttpHost }}",
        "description": "{{ 'home.subtitle'|trans }}",
        "logo": "{{ absolute_url(asset(site_brand.logo_asset)) }}",
        "sameAs": [
            "https://www.facebook.com/ruelledadem",
            "https://twitter.com/ruelledadem",
            "https://www.instagram.com/ruelledadem"
        ],
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bruxelles",
            "addressCountry": "BE"
        },
        "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "customer service",
            "email": "info@ruelledadem.com"
        }
    }
    </script>
    {%- set _all_tiers = (tiers_standard|default([]))|merge(tiers_vip|default([])) %}
    {%- for tier in _all_tiers %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ tier.title|json_encode()|raw }},
        "description": {{ (tier.detail|default(tier.title))|json_encode()|raw }},
        "brand": {
            "@type": "Brand",
            "name": {{ site_brand.title|json_encode()|raw }}
        },
        "offers": {
            "@type": "Offer",
            "url": "{{ app.request.schemeAndHttpHost ~ path('app_home') }}",
            "price": "{{ tier.unit_price_eur|number_format(2, '.', '') }}",
            "priceCurrency": "EUR",
            "availability": "https://schema.org/InStock"
        }
    }
    </script>
    {%- endfor %}
{% endblock %}

{% block street_main %}
    <input type="hidden" id="global-cart-url" value="{{ path('app_cart_index') }}">


    {# SECTION HERO #}
    <section class="hero hero--spray hero--intro">
        <div class="">
            <h1 class="hero__eyebrow">{{ site_brand.tagline }}</h1>
        </div>
    </section>



    {# SECTION MÉDIAS (GALERIE) #}
    <section class="section section--gallery" id="medias">
        <div class="section__inner">
            {% if media_items is not empty %}
                <div class="swiper media-swiper">
                    <div class="swiper-wrapper">
                        {% for media in media_items %}
                            <div class="swiper-slide">
                                <img src="{{ asset(media.assetPath) }}" alt="{{ media.alt|default(site_brand.title) }}" loading="lazy" decoding="async" width="300" height="300">
                            </div>
                        {% endfor %}
                    </div>
                    <div class="swiper-pagination"></div>
                    <div class="swiper-button-next" aria-label="Photo suivante"></div>
                    <div class="swiper-button-prev" aria-label="Photo précédente"></div>
                </div>
            {% endif %}
        </div>
    </section>

    {# SECTION CROWDFUNDING #}
    <section class="section" id="crowdfunding">
        <div class="section__inner section__inner--narrow">
            <div class="help-box">
                <h2 class="help-box__title">{{ 'home.help_title'|trans }}</h2>
                <div class="help-box__content">
                    <p>{{ 'home.help_content'|trans|nl2br }}</p>
                    <p>{{ 'home.help_vip'|trans|nl2br }}</p>
                    <div class="help-box__highlight">
                        <p>{{ 'home.help_note'|trans }}</p>
                    </div>
                </div>
                <p class="help-box__cta">{{ 'home.cta'|trans }}</p>
            </div>
        </div>
    </section>

    {# SECTION OFFRES STANDARD #}
    <section class="section section--offres" id="offres">
        <div class="section__inner">
            <h2 class="section__title section__title--tag">{{ sections.offres.title }}</h2>
            <p class="section__intro section__intro--muted">{{ sections.offres.intro }}</p>
            <div class="grid grid--tiers">
                {% for tier in tiers_standard %}
                    {% if tier.id != 'free_donation' %}
                    <article class="card card--tier {% if tier.id == 'begonia_unit' or tier.id == 'pack_3' %}card--featured {% endif %}card--sticker">
                        <h3 class="card__title">{{ tier.title }}</h3>
                        <p class="card__price">{{ tier.price }}&nbsp;{{ tier.price_unit }}</p>
                        <p class="card__detail">{{ tier.detail }}</p>
                        <div class="card__cart-controls" data-controller="product" data-product-tier-id-value="{{ tier.id }}" data-product-min-qty-value="{{ tier.min_qty }}" data-product-max-qty-value="{{ tier.max_qty }}">
                            <div class="qty-controls qty-controls--compact">
                                <button type="button" class="qty-btn" id="minus-{{ tier.id }}" data-action="product#decrement" aria-label="{{ 'home.qty_minus'|trans }}">-</button>
                                <div class="qty-display">
                                    <span class="qty-number" id="num-{{ tier.id }}">{{ tier.min_qty }}</span>
                                    <span class="qty-label" id="label-{{ tier.id }}" data-piece-singular="{{ 'home.piece'|trans }}" data-piece-plural="{{ 'home.piece_plural'|trans }}"></span>
                                </div>
                                <button type="button" class="qty-btn" id="plus-{{ tier.id }}" data-action="product#increment" aria-label="{{ 'home.qty_plus'|trans }}">+</button>
                            </div>
                            <input type="hidden" id="qty-{{ tier.id }}" value="{{ tier.min_qty }}">
                            <button type="button" class="btn btn--primary btn--small" data-cart-url="{{ path('app_cart_add') }}" data-action="product#add">{{ 'home.add_to_cart'|trans }}</button>
                        </div>
                    </article>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </section>

    {# SECTION FORMULES V.I.P. #}
    <section class="section section--vip" id="vip">
        <div class="section__inner">
            <h2 class="section__title section__title--tag section__title--vip">{{ sections.vip.title }}</h2>
            <p class="section__intro section__intro--muted">{{ sections.vip.subtitle }}</p>
            <div class="grid grid--tiers">
                {% for tier in tiers_vip %}
                    <article class="card card--tier card--featured card--sticker">
                        <h3 class="card__title">{{ tier.title }}</h3>
                        <p class="card__price">{{ tier.price }}&nbsp;{{ tier.price_unit }}</p>
                        <p class="card__detail">{{ tier.detail }}</p>
                        <div class="card__cart-controls" data-controller="product" data-product-tier-id-value="{{ tier.id }}" data-product-min-qty-value="{{ tier.min_qty }}" data-product-max-qty-value="{{ tier.max_qty }}">
                            <div class="qty-controls qty-controls--compact">
                                <button type="button" class="qty-btn" id="minus-{{ tier.id }}" data-action="product#decrement" aria-label="{{ 'home.qty_minus'|trans }}">-</button>
                                <div class="qty-display">
                                    <span class="qty-number" id="num-{{ tier.id }}">{{ tier.min_qty }}</span>
                                    <span class="qty-label" id="label-{{ tier.id }}" data-piece-singular="{{ 'home.piece'|trans }}" data-piece-plural="{{ 'home.piece_plural'|trans }}"></span>
                                </div>
                                <button type="button" class="qty-btn" id="plus-{{ tier.id }}" data-action="product#increment" aria-label="{{ 'home.qty_plus'|trans }}">+</button>
                            </div>
                            <input type="hidden" id="qty-{{ tier.id }}" value="{{ tier.min_qty }}">

                            <div class="form-group mt-1">
                                <label class="form__label">{{ 'home.displayed_name'|trans }} :</label>
                                <input type="text" id="donor-{{ tier.id }}" class="form__input form__input--don-libre" placeholder="{{ 'home.name_placeholder'|trans }}">
                                <label class="form__consent" for="donor-consent-{{ tier.id }}">
                                    <input type="checkbox" id="donor-consent-{{ tier.id }}" class="form__checkbox">
                                    <span>{{ 'home.donor_consent'|trans }}</span>
                                </label>
                            </div>
                            <button type="button" class="btn btn--primary btn--small mt-1" data-cart-url="{{ path('app_cart_add') }}" data-action="product#add">
                                {{ 'home.add_to_cart'|trans }}
                            </button>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    {# SECTION DON LIBRE #}
    <section class="section" id="don-libre">
        <div class="section__inner">
            <h2 class="section__title section__title--tag">{{ sections.don_libre.title }}</h2>
            <p class="section__intro section__intro--muted">{{ sections.don_libre.intro }}</p>
            <article class="card card--tier card--featured card--sticker card--center" data-controller="product" data-product-tier-id-value="free_donation">
                <div class="form">
                    <label class="form__label">{{ 'home.amount'|trans }} ({{ 'cart.currency_symbol'|trans }}) :</label>
                    <input type="number" id="free-amount" class="form__input form__input--don-libre" placeholder="{{ 'home.amount_example'|trans }}" min="1">

                    <label class="form__label mt-1">{{ 'home.displayed_name'|trans }} :</label>
                    <input type="text" id="donor-free_donation" class="form__input form__input--don-libre" placeholder="{{ 'home.anonymous'|trans }}">
                    <label class="form__consent" for="donor-consent-free_donation">
                        <input type="checkbox" id="donor-consent-free_donation" class="form__checkbox">
                        <span>{{ 'home.donor_consent'|trans }}</span>
                    </label>

                    <button type="button" class="btn btn--primary btn--small mt-1" data-cart-url="{{ path('app_cart_add') }}" data-action="product#add">
                        {{ 'home.add_to_cart'|trans }}
                    </button>
                </div>
            </article>
        </div>
    </section>

    {# SECTION NEWSLETTER #}
    <section class="section section--newsletter" id="newsletter">
        <div class="section__inner">
            <h2 class="section__title section__title--tag">{{ sections.newsletter.title }}</h2>
            <p class="section__intro section__intro--muted section__intro--multiline">{{ sections.newsletter.intro }}</p>
            <div class="section__actions">
                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('app_profile') }}" class="btn btn--primary">{{ 'home.view_profile'|trans }}</a>
                {% else %}
                    <a href="{{ path('app_register') }}" class="btn btn--primary">{{ 'home.newsletter_signup'|trans }}</a>
                {% endif %}
            </div>
        </div>
    </section>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}