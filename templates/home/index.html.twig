{% extends 'layout/street.html.twig' %}

{% block title %}Flower Power  Crowdfunding | {{ site_brand.title }}{% endblock %}

{% block street_main %}
    {# Jeton de sécurité global pour les appels AJAX #}
    <input type="hidden" id="global-csrf-token" value="{{ csrf_token('cart_add') }}">
    <input type="hidden" id="global-cart-url" value="{{ path('app_cart_index') }}">


    {# SECTION HERO #}
    <section class="hero hero--spray hero--intro">
        <div class="">
            <p class="hero__eyebrow">{{ site_brand.tagline }}</p>

        </div>
    </section>



    {# SECTION MÉDIAS (GALERIE) #}
    <section class="section" id="medias">
        <div class="section__inner">
            <h2 class="section__title section__title--tag">{{ sections.medias.title }}</h2>
            <p class="section__intro section__intro--muted">{{ medias_intro }}</p>
            {% if media_items is not empty %}
                <div class="swiper media-swiper">
                    <div class="swiper-wrapper">
                        {% for media in media_items %}
                            <div class="swiper-slide">
                                <img src="{{ asset(media.assetPath) }}" alt="{{ media.alt|default(site_brand.title) }}" loading="lazy">
                            </div>
                        {% endfor %}
                    </div>
                    <div class="swiper-pagination"></div>
                    <div class="swiper-button-next"></div>
                    <div class="swiper-button-prev"></div>
                </div>
            {% endif %}
        </div>
    </section>

    {# SECTION CROWDFUNDING #}
    <section class="section" id="crowdfunding">
        <div class="section__inner section__inner--narrow">
            <div class="help-box">
                <h2 class="help-box__title">ADEM DEMANDE TON AIDE</h2>
                <div class="help-box__content">
                    <p>Cent mètres de ruelle à décorer, fleurir et entretenir, cela coûte. L'aide de ses parents, amis et le subside communal ne suffisent pas.</p>
                    <p>Voilà pourquoi Adem te propose d'offrir des bégonias, des jardinières ou des palettes à sa ruelle*. En formule V.I.P, tu peux même les personnaliser.</p>
                    <div class="help-box__highlight">
                        <p>Les indications Bégonias, jardinières et palettes (non VIP) sont donnés à titre indicatifs. Les fonds récoltés pouvant être utilisés pour l'achat d'autres fleurs et plantes ou pour la décoration et l'entretien de La Ruelle d'Adem.</p>
                    </div>
                </div>
                <p class="help-box__cta">COMBIEN DE FLEURS À 1€, DE JARDINIÈRES OU DE PALETTES COMPTES-TU OFFRIR ?</p>
            </div>
        </div>
    </section>

    {# SECTION OFFRES STANDARD #}
    <section class="section section--offres" id="offres">
        <div class="section__inner">
            <h2 class="section__title section__title--tag">{{ sections.offres.title }}</h2>
            <p class="section__intro section__intro--muted">{{ sections.offres.intro }}</p>
            <div class="grid grid--tiers">
                {% for tier in tiers_standard %}
                    {% if tier.id != 'free_donation' %}
                    <article class="card card--tier {% if tier.id == 'begonia_unit' or tier.id == 'pack_3' %}card--featured {% endif %}card--sticker">
                        <h3 class="card__title">{{ tier.title }}</h3>
                        <p class="card__price">{{ tier.price }}&nbsp;{{ tier.price_unit }}</p>
                        <p class="card__detail">{{ tier.detail }}</p>
                        <div class="card__cart-controls">
                            <div class="qty-controls qty-controls--compact">
                                <button type="button" class="qty-btn" id="minus-{{ tier.id }}" onclick="updateQty('{{ tier.id }}', -1, {{ tier.min_qty }}, {{ tier.max_qty }})">-</button>
                                <div class="qty-display">
                                    <span class="qty-number" id="num-{{ tier.id }}">{{ tier.min_qty }}</span>
                                    <span class="qty-label" id="label-{{ tier.id }}">pièce{{ tier.min_qty > 1 ? 's' : '' }}</span>
                                </div>
                                <button type="button" class="qty-btn" id="plus-{{ tier.id }}" onclick="updateQty('{{ tier.id }}', 1, {{ tier.min_qty }}, {{ tier.max_qty }})">+</button>
                            </div>
                            <input type="hidden" id="qty-{{ tier.id }}" value="{{ tier.min_qty }}">
                            <button type="button" class="btn btn--primary btn--small" onclick="addToCart('{{ tier.id }}')">Ajouter</button>
                        </div>
                    </article>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </section>

    {# SECTION FORMULES V.I.P. #}
    <section class="section section--vip" id="vip">
        <div class="section__inner">
            <h2 class="section__title section__title--tag section__title--vip">{{ sections.vip.title }}</h2>
            <p class="section__intro section__intro--muted">{{ sections.vip.subtitle }}</p>
            <div class="grid grid--tiers">
                {% for tier in tiers_vip %}
                    <article class="card card--tier card--featured card--sticker">
                        <h3 class="card__title">{{ tier.title }}</h3>
                        <p class="card__price">{{ tier.price }}&nbsp;{{ tier.price_unit }}</p>
                        <p class="card__detail">{{ tier.detail }}</p>
                        <div class="card__cart-controls">
                            <div class="qty-controls qty-controls--compact">
                                <button type="button" class="qty-btn" id="minus-{{ tier.id }}" onclick="updateQty('{{ tier.id }}', -1, {{ tier.min_qty }}, {{ tier.max_qty }})">-</button>
                                <div class="qty-display">
                                    <span class="qty-number" id="num-{{ tier.id }}">{{ tier.min_qty }}</span>
                                    <span class="qty-label" id="label-{{ tier.id }}">pièce{{ tier.min_qty > 1 ? 's' : '' }}</span>
                                </div>
                                <button type="button" class="qty-btn" id="plus-{{ tier.id }}" onclick="updateQty('{{ tier.id }}', 1, {{ tier.min_qty }}, {{ tier.max_qty }})">+</button>
                            </div>
                            <input type="hidden" id="qty-{{ tier.id }}" value="{{ tier.min_qty }}">

                            <div class="form-group margin-top-1">
                                <label class="form__label">Nom affiché :</label>
                                <input type="text" id="donor-{{ tier.id }}" class="form__input form__input--don-libre" placeholder="Ton nom ou Anonyme">
                            </div>
                            <button type="button" class="btn btn--primary btn--small margin-top-0-5" onclick="addToCart('{{ tier.id }}')">
                                Ajouter au panier
                            </button>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    {# SECTION DON LIBRE #}
    <section class="section" id="don-libre">
        <div class="section__inner">
            <h2 class="section__title section__title--tag">{{ sections.don_libre.title }}</h2>
            <p class="section__intro section__intro--muted">{{ sections.don_libre.intro }}</p>
            <article class="card card--tier card--featured card--sticker card--center">
                <div class="form">
                    <label class="form__label">Montant (€) :</label>
                    <input type="number" id="free-amount" class="form__input form__input--don-libre" placeholder="Ex: 15" min="1">

                    <label class="form__label margin-top-1">Nom affiché :</label>
                    <input type="text" id="donor-free_donation" class="form__input form__input--don-libre" placeholder="Anonyme">

                    <button type="button" class="btn btn--primary btn--small margin-top-1" onclick="addToCart('free_donation')">
                        Ajouter au panier
                    </button>
                </div>
            </article>
        </div>
    </section>

    {# SECTION NEWSLETTER #}
    <section class="section section--newsletter" id="newsletter">
        <div class="section__inner">
            <h2 class="section__title section__title--tag">{{ sections.newsletter.title }}</h2>
            <p class="section__intro section__intro--muted section__intro--multiline">{{ sections.newsletter.intro }}</p>
            <div class="section__actions">
                {% if is_granted('ROLE_USER') %}
                    <a href="{{ path('app_profile') }}" class="btn btn--primary">Voir mon profil</a>
                {% else %}
                    <a href="{{ path('app_register') }}" class="btn btn--primary">Créer un compte pour recevoir les infos</a>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}