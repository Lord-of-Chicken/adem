{% extends 'layout/street.html.twig' %}

{% block title %}{{ page.title }} | {{ site_brand.title }}{% endblock %}
{% block meta_description %}{{ 'gallery.meta_description'|trans }}{% endblock %}
{% block og_title %}{{ page.title }} | {{ site_brand.title }}{% endblock %}
{% block og_description %}{{ 'gallery.meta_description'|trans }}{% endblock %}
{% block og_image %}{{ absolute_url(asset('img/Social/og-home-preview.jpg')) }}{% endblock %}

{% block head %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ImageGallery",
        "name": "{{ page.title }}",
        "description": "{{ 'gallery.meta_description'|trans }}",
        "url": "{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}",
        "provider": {
            "@type": "Organization",
            "name": "{{ site_brand.title }}",
            "url": "{{ app.request.schemeAndHttpHost }}"
        }
    }
    </script>
    {% include '_partials/breadcrumb_jsonld.html.twig' with { items: [
        { name: 'nav.home'|trans, url: url('app_home') },
        { name: page.title, url: url('app_gallery') }
    ] } %}
{% endblock %}

{% block street_main %}
<div class="">
    <section class="section section--gallery">
        <div class="section__inner">
            <h1 class="section__title section__title--tag">{{ page.title }}</h1>
            <p class="section__intro">{{ medias_intro }}</p>

            {% if media_items is not empty %}
                <div class="gallery-grid">
                    {% for media in media_items %}
                        <div class="gallery-item">
                            <img src="/{{ media.assetPath }}" alt="{{ media.alt|default(site_brand.title) }}" loading="lazy" decoding="async" width="300" height="300">
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="section__hint">{{ page.empty }}</p>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}
