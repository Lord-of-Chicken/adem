{% extends 'base.html.twig' %}

{% block title %}Galerie - La Ruelle d'Adem{% endblock %}

{% block body_class %}page-gallery{% endblock %}

{% block body %}
    <header class="page-header">
        <div class="page-header__inner">
            <h1 class="page-header__title">{{ sections.medias.title }}</h1>
            <p class="page-header__intro">{{ sections.medias.intro }}</p>
        </div>
    </header>

    <section class="section section--gallery">
        <div class="section__inner">
            {% if media_items is not empty %}
                <div class="gallery-grid">
                    {% for media in media_items %}
                        <div class="gallery-item">
                            <img src="{{ asset(media.assetPath) }}" alt="{{ media.alt|default('La Ruelle dAdem') }}" loading="lazy">
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="section__empty">Aucun média disponible pour le moment.</p>
            {% endif %}
        </div>
    </section>
{% endblock %}
