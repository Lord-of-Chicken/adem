{% extends 'layout/street.html.twig' %}

{% block title %}{{ page.title }} | La Ruelle d'Adem{% endblock %}

{% block street_main %}
<div class="main">
    <section class="section section--gallery">
        <div class="section__inner">
            <h1 class="section__title section__title--tag">{{ page.title }}</h1>
            <p class="section__intro">{{ page.intro }}</p>

            {% if media_items is not empty %}
                <div class="gallery-grid">
                    {% for media in media_items %}
                        <figure class="gallery-item">
                            <img src="{{ asset(media.assetPath) }}" alt="{{ media.alt|default('La Ruelle d\'Adem') }}" loading="lazy">
                        </figure>
                    {% endfor %}
                </div>
            {% else %}
                <p class="section__hint">{{ page.empty }}</p>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}
