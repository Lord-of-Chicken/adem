# Test database — same MySQL server as dev.
# NOTE: config/packages/doctrine.yaml appends `dbname_suffix: '_test'` in the test
# env, so the effective schema is `ruellenadem_test`. Do NOT add the suffix here.
# Functional tests (WebTestCase with DB) require this DB to exist + migrations applied.
DATABASE_URL="mysql://user:!ChangeMe!@127.0.0.1:3306/ruellenadem?serverVersion=8.4&charset=utf8mb4"
